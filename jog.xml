<Template>
  <!-- JOG SENSITIVITY page of the settings menu, shown in place of the menu
       while [Library],jog_page is 1 (JOG SENSITIVITY in the menu presses
       jog_open; BACK, the cog and the scrim take you back to it).

       The setting is how far one detent of the jog side ring bends the pitch
       of a playing deck, as a percentage of the built-in feel: 100% is the
       nudge this build has always had, lower is finer, higher is coarser.
       It lives in RateControl, so it holds for every deck and does not
       depend on which controller mapping sent the nudge.

       MINUS and PLUS step it by 10 points and apply it to the decks at once
       (the wheel is right there, and a feel setting is only ever judged by
       using it), so the number on screen is always what the wheels are
       doing. SAVE is what makes it outlast the session: it writes mixxx.cfg
       and flushes it to disk there and then, because POWER OFF two rows up
       in this menu never gives Mixxx a clean exit to save on. The button
       therefore has two faces driven by [Library],jog_dirty: a live SAVE
       while the value differs from the one on disk, and an inert SAVED once
       it matches. Leaving the page without saving keeps the new feel for the
       session and still shows it, unsaved, when the page is reopened.

       Unlike the Wi-Fi and update pages this one is a centred panel rather
       than a full screen: it is five controls, and keeping the settings
       panel's shape makes it read as the same menu one level down. It is
       fenced in by the same four scrim buttons (templates/settings_scrim.xml),
       so a tap outside dismisses the whole menu.

       Unpatched Mixxx has none of the jog_* controls, so jog_page is created
       at 0 by the skin parser, nothing ever sets it and the page simply never
       shows - the rest of the menu is unaffected. -->
  <WidgetGroup>
    <ObjectName>JogPageLayer</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>SettingsScrim</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <Template src="skin:templates/settings_scrim.xml">
            <SetVariable name="Size">0me,0me</SetVariable>
          </Template>

          <WidgetGroup>
            <ObjectName>SettingsScrimRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,418f</Size>
            <Children>
              <Template src="skin:templates/settings_scrim.xml">
                <SetVariable name="Size">0me,0me</SetVariable>
              </Template>

              <WidgetGroup>
                <ObjectName>JogPanel</ObjectName>
                <Layout>vertical</Layout>
                <Size>460f,418f</Size>
                <Children>
                  <Label>
                    <ObjectName>SettingsTitle</ObjectName>
                    <Text>JOG SENSITIVITY</Text>
                    <Size>0me,36f</Size>
                  </Label>

                  <Label>
                    <ObjectName>JogHint</ObjectName>
                    <Text>HOW FAR ONE NUDGE OF THE JOG SIDE BENDS THE PITCH</Text>
                    <Size>0me,48f</Size>
                  </Label>

                  <!-- MINUS, the value, PLUS. The number is a WNumber bound
                       to [Library],jog_value, which LibraryControl sets to
                       the percentage the decks are actually using, so it
                       stops at both ends of the range instead of counting
                       past it. -->
                  <WidgetGroup>
                    <ObjectName>JogValueRow</ObjectName>
                    <Layout>horizontal</Layout>
                    <Size>0me,84f</Size>
                    <Children>
                      <PushButton>
                        <ObjectName>JogLess</ObjectName>
                        <Size>110f,0me</Size>
                        <NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>&#8722;</Text></State>
                        <State><Number>1</Number><Text>&#8722;</Text></State>
                        <Connection>
                          <ConfigKey persist="false">[Library],jog_less</ConfigKey>
                          <ConnectValueToWidget>false</ConnectValueToWidget>
                          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                          <ButtonState>LeftButton</ButtonState>
                        </Connection>
                      </PushButton>

                      <Number>
                        <ObjectName>JogValue</ObjectName>
                        <SizePolicy>me,me</SizePolicy>
                        <NumberOfDigits>0</NumberOfDigits>
                        <Text>%1 %</Text>
                        <Connection>
                          <ConfigKey persist="false">[Library],jog_value</ConfigKey>
                        </Connection>
                      </Number>

                      <PushButton>
                        <ObjectName>JogMore</ObjectName>
                        <Size>110f,0me</Size>
                        <NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>+</Text></State>
                        <State><Number>1</Number><Text>+</Text></State>
                        <Connection>
                          <ConfigKey persist="false">[Library],jog_more</ConfigKey>
                          <ConnectValueToWidget>false</ConnectValueToWidget>
                          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                          <ButtonState>LeftButton</ButtonState>
                        </Connection>
                      </PushButton>
                    </Children>
                  </WidgetGroup>

                  <!-- Two faces of one row, as POWER OFF and RESTART do in
                       the menu: only one is visible at a time. SAVED presses
                       nothing - there is nothing left to write. -->
                  <WidgetGroup>
                    <ObjectName>SettingsRow</ObjectName>
                    <Layout>vertical</Layout>
                    <Size>0me,56f</Size>
                    <Children>
                      <PushButton>
                        <ObjectName>JogSave</ObjectName>
                        <SizePolicy>me,me</SizePolicy>
                        <NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>SAVE</Text></State>
                        <State><Number>1</Number><Text>SAVE</Text></State>
                        <Connection>
                          <ConfigKey persist="false">[Library],jog_save</ConfigKey>
                          <ConnectValueToWidget>false</ConnectValueToWidget>
                          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                          <ButtonState>LeftButton</ButtonState>
                        </Connection>
                        <Connection>
                          <ConfigKey persist="false">[Library],jog_dirty</ConfigKey>
                          <BindProperty>visible</BindProperty>
                        </Connection>
                      </PushButton>
                      <PushButton>
                        <ObjectName>JogSaved</ObjectName>
                        <SizePolicy>me,me</SizePolicy>
                        <NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>SAVED</Text></State>
                        <State><Number>1</Number><Text>SAVED</Text></State>
                        <Connection>
                          <ConfigKey persist="false">[Library],jog_dirty</ConfigKey>
                          <BindProperty>visible</BindProperty>
                          <Transform><Not/></Transform>
                        </Connection>
                      </PushButton>
                    </Children>
                  </WidgetGroup>

                  <WidgetGroup>
                    <ObjectName>SettingsRow</ObjectName>
                    <Layout>vertical</Layout>
                    <Size>0me,56f</Size>
                    <Children>
                      <PushButton>
                        <ObjectName>JogBack</ObjectName>
                        <SizePolicy>me,me</SizePolicy>
                        <NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>BACK</Text></State>
                        <State><Number>1</Number><Text>BACK</Text></State>
                        <Connection>
                          <ConfigKey persist="false">[Library],jog_back</ConfigKey>
                          <ConnectValueToWidget>false</ConnectValueToWidget>
                          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                          <ButtonState>LeftButton</ButtonState>
                        </Connection>
                      </PushButton>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>

              <Template src="skin:templates/settings_scrim.xml">
                <SetVariable name="Size">0me,0me</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>

          <Template src="skin:templates/settings_scrim.xml">
            <SetVariable name="Size">0me,0me</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey persist="false">[Library],jog_page</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
