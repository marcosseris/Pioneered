+// Pioneered: the deck's tempo is held on the mixxx::kBpmDisplayStep grid by
+// BpmControl::snapRateRatioToBpmStep, so the engine BPM normally lands on a
+// whole step already and this only writes it down exactly. It still matters
+// for the cases the snap deliberately keeps its hands off: a synced deck
+// follows its leader's rate, and a track whose beatgrid really does drift
+// measures a few hundredths either way as it plays. Rounding alone would
+// swap the readout between two numbers whenever such a value sat on a step
+// boundary, so the current step is only left once the reading is clear of
+// it -- which one whole step of the pitch fader always is.
+double DeckVisuals::steppedBpm(double bpm) {
+    if (bpm <= 0.0) {
+        m_visualBpm = 0.0;
+    } else if (m_visualBpm <= 0.0 ||
+            std::fabs(bpm - m_visualBpm) >= mixxx::kBpmDisplayStep * 0.75) {
+        m_visualBpm = std::round(bpm / mixxx::kBpmDisplayStep) * mixxx::kBpmDisplayStep;
+    }
+    return m_visualBpm;
+}
