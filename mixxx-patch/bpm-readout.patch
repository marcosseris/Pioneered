+double BpmControl::snapRateRatioToBpmStep(double rateRatio) const {
+    const double localBpm = m_pLocalBpm->get();
+    // No grid, or the deck is reversed or stopped by the rate itself: there
+    // is no BPM to land on, so leave the rate alone.
+    if (localBpm <= 0.0 || rateRatio <= 0.0) {
+        return rateRatio;
+    }
+    const double steppedBpm = std::round(localBpm * rateRatio / mixxx::kBpmDisplayStep) *
+            mixxx::kBpmDisplayStep;
+    if (steppedBpm <= 0.0) {
+        return rateRatio;
+    }
+    return steppedBpm / localBpm;
+}
