@@ -1175,6 +1182,15 @@
                     ColumnCache::COLUMN_LIBRARYTABLE_PLAYED);
             break;
         case ColumnCache::COLUMN_LIBRARYTABLE_BPM:
+            // XDJ: a model without a bpm_lock column has no lock state to
