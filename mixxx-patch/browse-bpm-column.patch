-    } else if (index == fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_BPM)) {
+    } else if (index == fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_BPM) &&
+            fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_BPM_LOCK) >= 0) {
+        // XDJ: BPMDelegate exists to draw and toggle the BPM-lock indicator,
