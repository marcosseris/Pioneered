 //
+// BROWSE encoder
+//
+
+// Pioneered: the BROWSE encoder does whatever the screen is showing. With the
+// Overview tab up it is the waveform zoom; in Browse/Search it scrolls the
+// list, exactly as the stock <SelectKnob/> binding to [Library],MoveVertical
+// did. [Tab],overview is the Overview page trigger of the skin's tab stack: it
+// is 1 only while that page is current, and LibraryControl creates it so this
+// read is safe under any skin (under a stock skin it stays 0 and the encoder
+// only ever scrolls).
+PioneerDDJ400.browseTurn = function(_channel, _control, value, _status, _group) {
+    // Relative, 7-bit two's complement: 0x01 = one detent clockwise,
+    // 0x7F = one counter-clockwise. This is the decode the <SelectKnob/>
+    // option used to do in C++; a Script-Binding gets the raw byte instead.
+    const delta = value < 0x40 ? value : value - 128;
+    if (delta === 0) {
+        return;
+    }
+
+    if (engine.getValue("[Tab]", "overview") > 0) {
+        PioneerDDJ400.waveformZoom(delta);
+        return;
+    }
+
+    engine.setValue("[Library]", "MoveVertical", delta);
+};
+
+// Pioneered: zoom both waveforms by one step per detent.
+//
+// waveform_zoom is how much track is on screen, so a *smaller* number is a
+// closer view: clockwise (delta > 0) has to subtract. The skin stacks both
+// decks' waveforms permanently, and they are only readable against each other
+// at a common scale, so one turn drives both from a single target rather than
+// stepping each deck from its own value -- that also pulls them back together
+// if they ever diverge.
+//
+// The range is clamped here because BaseTrackPlayerImpl ignores a change
+// request outside it rather than clamping into it, so an unclamped target at
+// either end would simply do nothing.
+PioneerDDJ400.waveformZoom = function(delta) {
+    const current = Math.round(engine.getValue("[Channel1]", "waveform_zoom"));
+    let target = current - delta;
+    if (target < PioneerDDJ400.waveformZoomMin) {
+        target = PioneerDDJ400.waveformZoomMin;
+    } else if (target > PioneerDDJ400.waveformZoomMax) {
+        target = PioneerDDJ400.waveformZoomMax;
+    }
+
+    for (const group of ["[Channel1]", "[Channel2]"]) {
+        engine.setValue(group, "waveform_zoom", target);
+    }
+};
+
+//
 // Channel level lights
