+// XDJ: zoom every deck's waveform by one step per detent, clockwise (v > 0)
+// zooming in.
+//
+// waveform_zoom is how much track is on screen, so a *smaller* number is a
+// closer view and zooming in has to subtract. The skin stacks the decks'
+// waveforms permanently and they are only readable against each other at a
+// common scale, so one turn drives them all from a single target rather than
+// stepping each deck from its own value -- that also pulls them back together
+// if they ever diverge. The current level is rounded first because the mouse
+// wheel (WWaveformViewer::wheelEvent) leaves fractional zoom levels behind.
+//
+// The range is clamped here because BaseTrackPlayerImpl ignores a change
+// request outside it rather than clamping into it, so an unclamped target at
+// either end would simply do nothing.
+void LibraryControl::zoomWaveforms(double v) {
+    const ConfigKey firstDeckZoom(PlayerManager::groupForDeck(0), "waveform_zoom");
+    double target = std::round(ControlObject::get(firstDeckZoom)) - v;
+    if (target < WaveformWidgetRenderer::s_waveformMinZoom) {
+        target = WaveformWidgetRenderer::s_waveformMinZoom;
+    } else if (target > WaveformWidgetRenderer::s_waveformMaxZoom) {
+        target = WaveformWidgetRenderer::s_waveformMaxZoom;
+    }
+
+    for (unsigned int deck = 0; deck < PlayerManager::numDecks(); ++deck) {
+        ControlObject::set(
+                ConfigKey(PlayerManager::groupForDeck(static_cast<int>(deck)),
+                        "waveform_zoom"),
+                target);
+    }
+}
