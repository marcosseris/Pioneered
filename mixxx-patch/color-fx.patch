new file mode 100644
index 0000000..40e06b3
--- /dev/null
+++ b/src/effects/colorfxcontrol.cpp
@@ -0,0 +1,237 @@
+#include "effects/colorfxcontrol.h"
+
+#include <QDomDocument>
+#include <QtDebug>
+
+#include "control/controlobject.h"
+#include "effects/backends/builtin/echoeffect.h"
+#include "effects/backends/builtin/filtereffect.h"
+#include "effects/backends/builtin/reverbeffect.h"
+#include "effects/backends/builtin/whitenoiseeffect.h"
+#include "effects/backends/effectmanifest.h"
+#include "effects/backends/effectsbackendmanager.h"
+#include "effects/chains/quickeffectchain.h"
+#include "effects/effectsmanager.h"
+#include "effects/presets/effectchainpreset.h"
+#include "effects/presets/effectpreset.h"
+#include "effects/presets/effectxmlelements.h"
+#include "moc_colorfxcontrol.cpp"
+#include "util/assert.h"
+
+namespace {
+
+const QString kGroup = QStringLiteral("[Pioneered]");
+const ConfigKey kConfigKey(kGroup, QStringLiteral("ColorFx"));
+const QString kDefaultOption = QStringLiteral("filter");
+
+// The knob position that leaves the sound untouched.
+constexpr double kCentre = 0.5;
+
+const QString kLinkedLeftRight = QStringLiteral("LINKED_LEFT_RIGHT");
+
+QDomElement childElement(const QDomElement& parent, const QString& tagName) {
+    return parent.firstChildElement(tagName);
+}
+
+void setChildText(QDomDocument* pDoc,
+        QDomElement element,
+        const QString& tagName,
+        const QString& text) {
+    QDomElement child = childElement(element, tagName);
+    if (child.isNull()) {
+        child = pDoc->createElement(tagName);
+        element.appendChild(child);
+    }
+    while (child.hasChildNodes()) {
+        child.removeChild(child.firstChild());
+    }
+    child.appendChild(pDoc->createTextNode(text));
+}
+
+/// Sets one parameter of an <Effect> element: its value (in the parameter's
+/// own units) and, if given, how the super knob drives it.
+void setParameter(QDomDocument* pDoc,
+        const QDomElement& effectElement,
+        const QString& parameterId,
+        double value,
+        const QString& linkType = QString()) {
+    const QDomElement parameters =
+            childElement(effectElement, EffectXml::kParametersRoot);
+    for (QDomElement parameter = parameters.firstChildElement(EffectXml::kParameter);
+            !parameter.isNull();
+            parameter = parameter.nextSiblingElement(EffectXml::kParameter)) {
+        if (childElement(parameter, EffectXml::kParameterId).text() != parameterId) {
+            continue;
+        }
+        setChildText(pDoc, parameter, EffectXml::kParameterValue, QString::number(value));
+        if (!linkType.isEmpty()) {
+            setChildText(pDoc, parameter, EffectXml::kParameterLinkType, linkType);
+        }
+        return;
+    }
+    qWarning() << "Color FX: effect has no parameter" << parameterId;
+}
+
+} // anonymous namespace
+
+ColorFxControl::ColorFxControl(UserSettingsPointer pConfig, EffectsManager* pEffectsManager)
+        : m_pConfig(pConfig),
+          m_pEffectsManager(pEffectsManager),
+          m_selected(-1) {
+    // Pioneer order: SPACE, DUB ECHO, NOISE, FILTER.
+    const struct {
+        const char* id;
+        const char* name;
+        QString effectId;
+    } kOptions[] = {
+            {"space", "Space", ReverbEffect::getId()},
+            {"dub_echo", "Dub Echo", EchoEffect::getId()},
+            {"noise", "Noise", WhiteNoiseEffect::getId()},
+            {"filter", "Filter", QString()},
+    };
+    for (const auto& option : kOptions) {
+        Option entry;
+        entry.id = QString::fromLatin1(option.id);
+        entry.name = QString::fromLatin1(option.name);
+        entry.pPreset = buildPreset(entry.name, option.effectId);
+        entry.pControl = std::make_unique<ControlObject>(
+                ConfigKey(kGroup, QStringLiteral("color_fx_") + entry.id));
+        const int index = static_cast<int>(m_options.size());
+        entry.pControl->connectValueChangeRequest(this, [this, index](double value) {
+            if (value > 0) {
+                select(index);
+            }
+            // A request for 0 is a tap on the button that is already lit:
+            // one option is always selected, so it stays lit.
+        });
+        m_options.push_back(std::move(entry));
+    }
+
+    const QString saved = m_pConfig->getValue(kConfigKey, kDefaultOption);
+    for (int i = 0; i < static_cast<int>(m_options.size()); ++i) {
+        if (m_options[i].id == saved) {
+            m_selected = i;
+        }
+        if (m_options[i].id == kDefaultOption && m_selected < 0) {
+            m_selected = i;
+        }
+    }
+    for (int i = 0; i < static_cast<int>(m_options.size()); ++i) {
+        m_options[i].pControl->setAndConfirm(i == m_selected ? 1.0 : 0.0);
+    }
+}
+
+ColorFxControl::~ColorFxControl() = default;
+
+EffectChainPresetPointer ColorFxControl::buildPreset(
+        const QString& name, const QString& effectId) const {
+    const EffectsBackendManagerPointer pBackendManager =
+            m_pEffectsManager->getBackendManager();
+    const EffectManifestPointer pFilterManifest = pBackendManager->getManifest(
+            FilterEffect::getId(), EffectBackendType::BuiltIn);
+    VERIFY_OR_DEBUG_ASSERT(pFilterManifest) {
+        return EffectChainPresetPointer();
+    }
+
+    // Start from each effect's manifest defaults (so every parameter is
+    // present and in manifest order, which is the order the parameter slots
+    // are filled in), then change what the Color FX needs. The filter's own
+    // links -- low-pass on the left half, high-pass on the right -- are
+    // already the Pioneer sweep and are left alone.
+    QDomDocument doc;
+    QDomElement chain = EffectChainPreset(
+            EffectPresetPointer::create(pFilterManifest))
+                                .toXml(&doc);
+    setChildText(&doc, chain, EffectXml::kChainName, name);
+    setChildText(&doc, chain, EffectXml::kChainSuperParameter, QString::number(kCentre));
+    QDomElement effects = childElement(chain, EffectXml::kEffectsRoot);
+    QDomElement filter = childElement(effects, EffectXml::kEffect);
+    setChildText(&doc, filter, EffectXml::kEffectMetaParameter, QString::number(kCentre));
+
+    if (!effectId.isEmpty()) {
+        const EffectManifestPointer pManifest =
+                pBackendManager->getManifest(effectId, EffectBackendType::BuiltIn);
+        VERIFY_OR_DEBUG_ASSERT(pManifest) {
+            return EffectChainPresetPointer();
+        }
+        QDomElement effect = EffectPreset(pManifest).toXml(&doc);
+        setChildText(&doc, effect, EffectXml::kEffectMetaParameter, QString::number(kCentre));
+        // The effect's amount is silent at the centre and full at either end,
+        // so the knob adds it the same way in both directions while the
+        // filter behind it decides which part of the spectrum is heard.
+        if (effectId == ReverbEffect::getId()) {
+            setParameter(&doc, effect, QStringLiteral("send_amount"), 0.0, kLinkedLeftRight);
+            // A longer room than the default, as SPACE is.
+            setParameter(&doc, effect, QStringLiteral("decay"), 0.7);
+        } else if (effectId == EchoEffect::getId()) {
+            setParameter(&doc, effect, QStringLiteral("send_amount"), 0.0, kLinkedLeftRight);
+            // Half-beat repeats, quantized (the default), that ring on after
+            // the knob is back at the centre -- the "dub" in DUB ECHO.
+            setParameter(&doc, effect, QStringLiteral("delay_time"), 0.5);
+            setParameter(&doc, effect, QStringLiteral("feedback_amount"), 0.75);
+        } else if (effectId == WhiteNoiseEffect::getId()) {
+            setParameter(&doc, effect, QStringLiteral("dry_wet"), 0.0, kLinkedLeftRight);
+        }
+        // Effect first, filter second: the filter shapes the effect as well.
+        effects.insertBefore(effect, filter);
+    }
+    return EffectChainPresetPointer::create(chain);
+}
+
+void ColorFxControl::select(int optionIndex) {
+    if (optionIndex < 0 || optionIndex >= static_cast<int>(m_options.size())) {
+        return;
+    }
+    const bool changed = optionIndex != m_selected;
+    m_selected = optionIndex;
+    for (int i = 0; i < static_cast<int>(m_options.size()); ++i) {
+        m_options[i].pControl->setAndConfirm(i == m_selected ? 1.0 : 0.0);
+    }
+    if (!changed) {
+        return;
+    }
+    applyToAllDecks();
+    m_pConfig->setValue(kConfigKey, m_options[m_selected].id);
+    // Flush now: POWER OFF gives Mixxx no clean exit to save on.
+    if (!m_pConfig->save()) {
+        qWarning() << "Color FX: could not write the selection to"
+                   << m_pConfig->getSettingsPath();
+    }
+}
+
+void ColorFxControl::applyToAllDecks() {
+    for (int deck = 1;; ++deck) {
+        const QString group = QStringLiteral("[Channel%1]").arg(deck);
+        const QuickEffectChainPointer pChain =
+                m_pEffectsManager->getQuickEffectChain(group);
+        if (!pChain) {
+            break;
+        }
+        applyToChain(pChain);
+    }
+}
+
+void ColorFxControl::applyToDeck(const QString& deckGroup) {
+    const QuickEffectChainPointer pChain =
+            m_pEffectsManager->getQuickEffectChain(deckGroup);
+    if (pChain) {
+        applyToChain(pChain);
+    }
+}
+
+void ColorFxControl::applyToChain(const QuickEffectChainPointer& pChain) {
+    if (m_selected < 0) {
+        return;
+    }
+    const EffectChainPresetPointer& pPreset = m_options[m_selected].pPreset;
+    if (!pPreset) {
+        return;
+    }
+    // Loading a QuickEffect preset puts the super knob at the preset's value
+    // (the centre). The FILTER knob on the controller has not moved, so put
+    // the super knob back where the knob is; the new effect then comes in at
+    // the same setting instead of the knob going dead until it is turned.
+    const double superKnob = pChain->getSuperParameter();
+    pChain->loadChainPreset(pPreset);
+    pChain->setSuperParameter(superKnob, true);
+}
