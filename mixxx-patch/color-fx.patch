+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <memory>
+#include <vector>
+
+#include "effects/defs.h"
+#include "preferences/usersettings.h"
+
+class ControlObject;
+class EffectsManager;
+
+/// Pioneered: the Color FX buttons. The DDJ-400's FILTER knob on each channel
+/// drives that deck's QuickEffect chain ([QuickEffectRack1_[ChannelN]],
+/// super1); this picks what the knob does, for both decks at once, the way
+/// the SOUND COLOR FX buttons on a Pioneer mixer do. Every option is quiet
+/// with the knob at the centre and sweeps a filter towards either end:
+///
+///   SPACE     reverb, rising towards both ends, through the filter
+///   DUB ECHO  echo, rising towards both ends, through the filter
+///   NOISE     white noise, rising towards both ends, through the filter
+///   FILTER    the filter alone (what the knob did before)
+///
+/// The chains are built here from the effects' own defaults rather than taken
+/// from the QuickEffect preset list, so they do not depend on what is in the
+/// preferences, and cannot be renamed, reordered or deleted from under the
+/// buttons.
+///
+/// Controls, one per option: [Pioneered],color_fx_space / color_fx_dub_echo /
+/// color_fx_noise / color_fx_filter. Each reads 1 while its option is the
+/// selected one; setting it to 1 selects it, and setting the selected one to
+/// 0 is refused, so four plain two-state skin buttons behave as radio buttons.
+/// The choice is saved to mixxx.cfg ([Pioneered] ColorFx) at once, since the
+/// unit is usually switched off without a clean exit.
+class ColorFxControl : public QObject {
+    Q_OBJECT
+  public:
+    ColorFxControl(UserSettingsPointer pConfig, EffectsManager* pEffectsManager);
+    ~ColorFxControl() override;
+
+    /// Load the selected option into every deck's QuickEffect chain.
+    void applyToAllDecks();
+    /// Load the selected option into one deck's QuickEffect chain (a deck
+    /// added after startup).
+    void applyToDeck(const QString& deckGroup);
+
+  private:
+    struct Option {
+        QString id; // saved in mixxx.cfg and part of the control name
+        QString name; // the chain preset name
+        std::unique_ptr<ControlObject> pControl;
+        EffectChainPresetPointer pPreset;
+    };
+
+    void select(int optionIndex);
+    void applyToChain(const QuickEffectChainPointer& pChain);
+    EffectChainPresetPointer buildPreset(const QString& name,
+            const QString& effectId) const;
+
+    UserSettingsPointer m_pConfig;
+    EffectsManager* m_pEffectsManager;
+    std::vector<Option> m_options;
+    int m_selected;
+};
