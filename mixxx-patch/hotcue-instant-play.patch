+++ b/src/engine/controls/cuecontrol.cpp
@@ -1134,8 +1134,24 @@ void CueControl::hotcueActivate(HotcueControl* pControl, double value, HotcueSet
                 default:
                     DEBUG_ASSERT(!"Invalid CueType!");
                 }
+            } else if (m_currentlyPreviewingIndex == Cue::kNoHotCue) {
+                // Pioneered: pressed during pause. A CDJ starts playing from
+                // the hot cue and keeps playing when the pad is let go; Mixxx
+                // previewed it instead (play while held, jump back and stop on
+                // release). A saved loop starts looping from its start. The
+                // preview is still available as hotcue_X_activate_preview.
+                switch (pCue->getType()) {
+                case mixxx::CueType::HotCue:
+                    hotcueGotoAndPlay(pControl, value);
+                    break;
+                case mixxx::CueType::Loop:
+                    hotcueGotoAndLoop(pControl, value);
+                    break;
+                default:
+                    DEBUG_ASSERT(!"Invalid CueType!");
+                }
             } else {
-                // pressed during pause or preview
+                // pressed during preview
                 hotcueActivatePreview(pControl, value);
             }
         } else {
