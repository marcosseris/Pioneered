+void LibraryControl::openJogPage() {
+    m_disarmTimer.stop();
+    m_pArmPower->setAndConfirm(0.0);
+    m_pArmRestart->setAndConfirm(0.0);
+    // Open on what the decks are using rather than on what was saved: a value
+    // tried out and left unsaved is still the feel of the wheel, and the page
+    // would be lying if it showed anything else. applyJogSensitivity() also
+    // recomputes jog_dirty, so SAVE is offered again in exactly that case.
+    applyJogSensitivity(RateControl::jogNudgeSensitivityPercent());
+    m_pJogPage->setAndConfirm(1.0);
+    updateSubpageControl();
+}
+
+void LibraryControl::closeJogPage() {
+    // Leaving the page keeps the value the decks are playing with; only SAVE
+    // makes it outlast the session, and an unsaved change is still on screen
+    // when the page is reopened.
+    m_pJogPage->setAndConfirm(0.0);
+    updateSubpageControl();
+}
+
+void LibraryControl::stepJogSensitivity(int deltaPercent) {
+    applyJogSensitivity(
+            RateControl::jogNudgeSensitivityPercent() + deltaPercent);
+}
+
+void LibraryControl::applyJogSensitivity(int percent) {
+    RateControl::setJogNudgeSensitivityPercent(percent);
+    // Read back rather than trusting the argument: RateControl clamps to its
+    // own range, and at either end the display would otherwise drift past the
+    // value the decks are really using.
+    const int applied = RateControl::jogNudgeSensitivityPercent();
+    m_pJogValue->set(applied);
+    m_pJogDirty->setAndConfirm(applied == m_jogSavedPercent ? 0.0 : 1.0);
+}
+
+void LibraryControl::saveJogSensitivity() {
+    const int percent = RateControl::jogNudgeSensitivityPercent();
+    if (percent == m_jogSavedPercent) {
+        return; // already what is on disk; the button reads SAVED
+    }
+    if (!m_pLibrary) {
+        return;
+    }
+    const UserSettingsPointer& pConfig = m_pLibrary->config();
+    if (!pConfig) {
+        return;
+    }
+    pConfig->setValue(ConfigKey(RateControl::kJogNudgeSensitivityGroup,
+                              RateControl::kJogNudgeSensitivityItem),
+            percent);
+    // Flush now instead of leaving it to the save on a clean exit: POWER OFF
+    // is two rows up in this same menu and cuts the power from under Mixxx,
+    // and a SAVE that only survives a tidy shutdown is not a save.
+    if (!pConfig->save()) {
+        qWarning() << "Settings menu: could not write the jog sensitivity to"
+                   << pConfig->getSettingsPath();
+        return;
+    }
+    m_jogSavedPercent = percent;
+    m_pJogDirty->setAndConfirm(0.0);
+}
+
 void LibraryControl::updateSubpageControl() {
-    const bool anyOpen = m_pWifiPage->get() > 0.0 || m_pUpdatePage->get() > 0.0;
