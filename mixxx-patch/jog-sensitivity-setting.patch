+// Pioneered: JOG SENSITIVITY, the on-screen setting for how far one detent of
+// the jog side ring bends the pitch of a playing deck. The mapping's bendScale
+// sets the built-in feel (100%); this is the operator's multiplier on top of
+// it, applied in the engine so it holds for any controller and any mapping,
+// and for the keyboard, rather than only for the copy of the DDJ-400 script
+// this build happens to ship.
+void RateControl::setJogNudgeSensitivityPercent(int percent) {
+    m_jogNudgeSensitivityPercent.setValue(math_clamp(percent,
+            kJogNudgeSensitivityMinPercent,
+            kJogNudgeSensitivityMaxPercent));
+}
+
+int RateControl::jogNudgeSensitivityPercent() {
+    const int percent = m_jogNudgeSensitivityPercent.getValue();
+    // Zero-initialised static: nothing has loaded the setting yet.
+    return percent > 0 ? percent : kJogNudgeSensitivityDefaultPercent;
+}
+
+double RateControl::jogNudgeSensitivityMultiplier() {
+    return jogNudgeSensitivityPercent() / 100.0;
+}
+
 void RateControl::updateJogFilter(int iSamplesPerBuffer) {
     // Pioneered: keep the jog smoothing window a fixed length of time and the
     // nudge displacement independent of the audio buffer size. Only recompute
@@ -525,7 +559,12 @@
                     rate = math_max(speed + getTempRate(), 0.0);
                     rate += wheelFactor;
                 }
-                rate += jogFactor;
+                // Pioneered: JOG SENSITIVITY scales the nudge. Only here,
+                // on the playing path: on a paused deck the same jogFactor
+                // scrubs through the track (above), and cueing should not
+                // speed up or slow down because the beatmatch nudge was
+                // tuned.
+                rate += jogFactor * jogNudgeSensitivityMultiplier();
             }
         }
 
