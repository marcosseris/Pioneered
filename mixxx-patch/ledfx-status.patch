+void LibraryControl::slotPollLedFx() {
+    if (m_ledFxPollRunning || m_ledFxToggleRunning) {
+        return;
+    }
+    // [Skin],show_settings is created by the skin, after this object; until
+    // then (and on a skin without the panel) there is nothing to show.
+    ControlObject* pShowSettings = ControlObject::getControl(
+            ConfigKey("[Skin]", "show_settings"),
+            ControlFlag::NoWarnIfMissing);
+    if (!pShowSettings || pShowSettings->get() <= 0.0) {
+        return;
+    }
+    // Green only if the service is up AND the Pi is on a network: WLED is
+    // reached over the LAN, so "limited" (LAN without internet) still counts.
+    const QString script = QStringLiteral(
+            "systemctl is-active --quiet ledfx || exit 1; "
+            "case \"$(nmcli -t networking connectivity 2>/dev/null)\" in "
+            "full|limited) exit 0;; *) exit 1;; esac");
+    m_ledFxPollRunning = true;
+    auto* pProcess = new QProcess(this);
+    connect(pProcess,
+            QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this,
+            [this, pProcess](int exitCode, QProcess::ExitStatus exitStatus) {
+                pProcess->deleteLater();
+                m_ledFxPollRunning = false;
+                const bool up = exitStatus == QProcess::NormalExit &&
+                        exitCode == 0;
+                m_pLedFxStatus->forceSet(up ? 1.0 : 0.0);
+            });
+    connect(pProcess,
+            &QProcess::errorOccurred,
+            this,
+            [this, pProcess](QProcess::ProcessError error) {
+                if (error == QProcess::FailedToStart) {
+                    pProcess->deleteLater();
+                    m_ledFxPollRunning = false;
+                    m_pLedFxStatus->forceSet(0.0);
+                }
+            });
+    pProcess->start(QStringLiteral("/bin/sh"),
+            {QStringLiteral("-c"), script});
+}
+
+void LibraryControl::slotLedFxToggle(double v) {
+    if (v <= 0.0 || m_ledFxToggleRunning) {
+        return;
+    }
+    // Stop when it shows green, otherwise start: a red button means "off or
+    // no network", and starting an already-running service is harmless.
+    // Needs the passwordless sudo rule pi/ledfx-install.sh installs.
+    const bool stop = m_pLedFxStatus->get() > 0.0;
+    const QString script = stop
+            ? QStringLiteral("sudo -n systemctl stop ledfx")
+            : QStringLiteral("sudo -n systemctl start ledfx");
+    qWarning() << "Settings menu: LEDS:" << script;
+    m_ledFxToggleRunning = true;
+    auto* pProcess = new QProcess(this);
+    connect(pProcess,
+            QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this,
+            [this, pProcess](int exitCode, QProcess::ExitStatus exitStatus) {
+                pProcess->deleteLater();
+                m_ledFxToggleRunning = false;
+                if (exitStatus != QProcess::NormalExit || exitCode != 0) {
+                    qWarning() << "LEDS toggle failed:"
+                               << QString::fromUtf8(
+                                          pProcess->readAllStandardError())
+                                          .trimmed();
+                }
+                slotPollLedFx();
+            });
+    connect(pProcess,
+            &QProcess::errorOccurred,
+            this,
+            [this, pProcess](QProcess::ProcessError error) {
+                if (error == QProcess::FailedToStart) {
+                    pProcess->deleteLater();
+                    m_ledFxToggleRunning = false;
+                }
+            });
+    pProcess->start(QStringLiteral("/bin/sh"),
+            {QStringLiteral("-c"), script});
+}
