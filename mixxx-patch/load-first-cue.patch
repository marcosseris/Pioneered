diff --git a/src/test/cuecontrol_test.cpp b/src/test/cuecontrol_test.cpp
index 5666a9b..6d01d8e 100644
--- a/src/test/cuecontrol_test.cpp
+++ b/src/test/cuecontrol_test.cpp
@@ -300,6 +300,45 @@ TEST_F(CueControlTest, SeekOnLoadDefault) {
     EXPECT_FRAMEPOS_EQ(mixxx::audio::FramePos(250.0), getCurrentFramePos());
 }
 
+TEST_F(CueControlTest, SeekOnLoadFirstCue) {
+    // Pioneered: in the default mode a track with cues loads at the first of
+    // them -- here a hot cue ahead of the main cue (the first rekordbox
+    // memory cue) -- rather than at the intro start. A saved loop that starts
+    // even earlier is not a cue to load at.
+    TrackPointer pTrack = createTestTrack();
+    pTrack->setMainCuePosition(mixxx::audio::FramePos(300.0));
+    pTrack->createAndAddCue(mixxx::CueType::HotCue,
+            2,
+            mixxx::audio::FramePos(200.0),
+            mixxx::audio::kInvalidFramePos);
+    pTrack->createAndAddCue(mixxx::CueType::Loop,
+            0,
+            mixxx::audio::FramePos(100.0),
+            mixxx::audio::FramePos(150.0));
+    pTrack->createAndAddCue(mixxx::CueType::Intro,
+            Cue::kNoHotCue,
+            mixxx::audio::FramePos(250.0),
+            mixxx::audio::kInvalidFramePos);
+
+    loadTrack(pTrack);
+    EXPECT_FRAMEPOS_EQ(mixxx::audio::FramePos(200.0), getCurrentFramePos());
+
+    // Analysis finishing does not pull it over to the intro start.
+    pTrack->analysisFinished();
+    ProcessBuffer();
+    EXPECT_FRAMEPOS_EQ(mixxx::audio::FramePos(200.0), getCurrentFramePos());
+}
+
+TEST_F(CueControlTest, SeekOnLoadMainCueWithoutHotcues) {
+    // Pioneered: with no hot cues, the main cue is the first cue.
+    TrackPointer pTrack = createTestTrack();
+    pTrack->setMainCuePosition(mixxx::audio::FramePos(300.0));
+
+    loadTrack(pTrack);
+    EXPECT_FRAMEPOS_EQ_CONTROL(mixxx::audio::FramePos(300.0), m_pCuePoint);
+    EXPECT_FRAMEPOS_EQ(mixxx::audio::FramePos(300.0), getCurrentFramePos());
+}
+
 TEST_F(CueControlTest, SeekOnLoadMainCue) {
