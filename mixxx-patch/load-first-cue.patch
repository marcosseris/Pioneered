@@ -535,6 +535,19 @@ void CueControl::trackLoaded(TrackPointer pNewTrack) {
     // Seek track according to SeekOnLoadMode.
     SeekOnLoadMode seekOnLoadMode = getSeekOnLoadPreference();
 
+    // Pioneered: like a CDJ, a track with cues loads at the first of them.
+    // Mixxx's default mode is the intro start, which a rekordbox track does
+    // not have until it has been analysed here, so it loaded at 0:00 even
+    // with memory cues on it. Only "Beginning" still means 0:00 -- it keeps
+    // the vinyl-control needle drop working.
+    if (seekOnLoadMode != SeekOnLoadMode::Beginning) {
+        const auto firstCue = firstCuePosition(pNewTrack);
+        if (firstCue.isValid()) {
+            seekOnLoad(firstCue);
+            return;
+        }
+    }
+
     switch (seekOnLoadMode) {
     case SeekOnLoadMode::Beginning:
         // This allows users to load tracks and have the needle-drop be maintained.
@@ -600,6 +613,36 @@ void CueControl::trackLoaded(TrackPointer pNewTrack) {
     seekOnLoad(mixxx::audio::kStartFramePos);
 }
 
+mixxx::audio::FramePos CueControl::firstCuePosition(const TrackPointer& pTrack) const {
+    // The first hot cue is the lowest-numbered pad holding one, as in Mixxx's
+    // "First hotcue" mode, not the earliest cue in the track: the first
+    // rekordbox memory cue (the main cue) usually sits on the first beat, at
+    // about 0:00, and picking the earliest cue loaded nearly every track
+    // there. The import puts the other memory cues on pads after all the
+    // rekordbox hot cues, so a real hot cue always comes first. Saved loops
+    // are skipped.
+    for (const auto* pControl : std::as_const(m_hotcueControls)) {
+        const CuePointer pCue = pControl->getCue();
+        if (!pCue || pCue->getType() != mixxx::CueType::HotCue) {
+            continue;
+        }
+        const auto position = pControl->getPosition();
+        if (position.isValid()) {
+            return position;
+        }
+    }
+    // No hot cue: the main cue. A track with no main cue still shows
+    // cue_point 0 (the default), so it counts only when the track really has
+    // one.
+    if (pTrack && pTrack->findCueByType(mixxx::CueType::MainCue)) {
+        // From the CO rather than the cue, like SeekOnLoadMode::MainCue:
+        // the CO is quantized when quantize is on.
+        return mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(
+                m_pCuePoint->get());
+    }
+    return {};
+}
+
 void CueControl::seekOnLoad(mixxx::audio::FramePos seekOnLoadPosition) {
     DEBUG_ASSERT(seekOnLoadPosition.isValid());
     seekExact(seekOnLoadPosition);
@@ -764,6 +807,23 @@ void CueControl::trackAnalyzed() {
     // Make track follow the updated cues.
     SeekOnLoadMode seekOnLoadMode = getSeekOnLoadPreference();
 
+    // Pioneered: same rule as on load. Analysis gives a track with no main
+    // cue one at its first sound, so a track that loaded at 0:00 moves there,
+    // and a track that loaded at a cue stays on it instead of
+    // following the intro start that analysis adds.
+    if (seekOnLoadMode != SeekOnLoadMode::Beginning) {
+        TrackPointer pTrack;
+        {
+            auto lock = lockMutex(&m_trackMutex);
+            pTrack = m_pLoadedTrack;
+        }
+        const auto firstCue = firstCuePosition(pTrack);
+        if (firstCue.isValid()) {
+            seekOnLoad(firstCue);
+            return;
+        }
+    }
+
