+TEST_F(HotcueControlTest, LoadTrackDoesNotRestoreLoop) {
+    // Pioneered: a track loads with no loop armed, like on a Pioneer player,
+    // even when it was ejected with a loop set. A loop left armed in the
+    // middle of the track catches the deck on RELOOP/EXIT and turns the next
+    // LOOP IN into a loop that runs all the way to it.
+    TrackPointer pTrack = loadTestTrackWithBpm(120.0);
+
+    // Set a beatloop, then leave it
+    m_pBeatloopActivate->set(1);
+    m_pBeatloopActivate->set(0);
+    ProcessBuffer();
+    m_pLoopEnabled->set(0);
+    ProcessBuffer();
+    EXPECT_TRUE(mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(
+            m_pLoopStartPosition->get())
+                        .isValid());
+    EXPECT_TRUE(mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(
+            m_pLoopEndPosition->get())
+                        .isValid());
+
+    unloadTrack();
+    loadTrack(pTrack);
+
+    EXPECT_FALSE(mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(
+            m_pLoopStartPosition->get())
+                         .isValid());
+    EXPECT_FALSE(mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(
+            m_pLoopEndPosition->get())
+                         .isValid());
+    EXPECT_FALSE(m_pLoopEnabled->toBool());
+}
