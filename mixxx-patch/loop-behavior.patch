+// Pioneered: move one end of the loop by a jog wheel tick, keeping the loop
+// intact. The two points may never meet: see loopAdjustMinSamples.
+PioneerDDJ400.adjustLoopPoint = function(group, adjustIn, ticks) {
+    const start = engine.getValue(group, "loop_start_position");
+    const end = engine.getValue(group, "loop_end_position");
+
+    if (start < 0 || end < 0) {
+        return;
+    }
+
+    const delta = ticks * PioneerDDJ400.loopAdjustMultiply;
+
+    if (adjustIn) {
+        const limit = end - PioneerDDJ400.loopAdjustMinSamples;
+        engine.setValue(group, "loop_start_position",
+            Math.max(0, Math.min(start + delta, limit)));
+    } else {
+        const limit = start + PioneerDDJ400.loopAdjustMinSamples;
+        const trackEnd = engine.getValue(group, "track_samples");
+        let target = Math.max(limit, end + delta);
+        if (trackEnd > 0) {
+            target = Math.min(target, Math.max(limit, trackEnd));
+        }
+        engine.setValue(group, "loop_end_position", target);
+    }
+};
