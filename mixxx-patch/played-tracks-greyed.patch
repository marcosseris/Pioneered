diff --git a/src/library/xdjplayedtracks.cpp b/src/library/xdjplayedtracks.cpp
new file mode 100644
index 0000000..eda79a9
--- /dev/null
+++ b/src/library/xdjplayedtracks.cpp
@@ -0,0 +1,91 @@
+#include "library/xdjplayedtracks.h"
+
+#include "control/controlobject.h"
+#include "control/controlproxy.h"
+#include "mixer/playerinfo.h"
+#include "moc_xdjplayedtracks.cpp"
+#include "track/track.h"
+
+namespace {
+
+// Coarse on purpose: the threshold is 30 s and a second either way does not
+// matter. Time is measured, not counted in ticks, so a late tick is not lost.
+constexpr int kTickIntervalMs = 1000;
+
+} // anonymous namespace
+
+// static
+XdjPlayedTracks& XdjPlayedTracks::instance() {
+    static XdjPlayedTracks* s_pInstance = new XdjPlayedTracks();
+    return *s_pInstance;
+}
+
+XdjPlayedTracks::XdjPlayedTracks() {
+    connect(&m_timer, &QTimer::timeout, this, &XdjPlayedTracks::slotTick);
+    m_timer.start(kTickIntervalMs);
+    m_sinceLastTick.start();
+}
+
+XdjPlayedTracks::~XdjPlayedTracks() = default;
+
+void XdjPlayedTracks::slotTick() {
+    const qint64 elapsedMs = m_sinceLastTick.restart();
+    bool changed = false;
+    for (int i = 0; i < kMaxDecks; ++i) {
+        DeckState& deck = m_decks[i];
+        const QString group = QStringLiteral("[Channel%1]").arg(i + 1);
+        if (!deck.pPlay) {
+            // The decks may not exist yet on the first ticks, and a deck
+            // added later in the preferences turns up here too.
+            const ConfigKey playKey(group, QStringLiteral("play"));
+            if (!ControlObject::exists(playKey)) {
+                continue;
+            }
+            deck.pPlay = std::make_unique<ControlProxy>(playKey, this);
+        }
+        const TrackPointer pTrack = PlayerInfo::instance().getTrackInfo(group);
+        const QString location = pTrack ? pTrack->getLocation() : QString();
+        if (location != deck.location) {
+            // A new track starts from zero, even one played before.
+            deck.location = location;
+            deck.playedMs = 0;
+        }
+        if (location.isEmpty() || !deck.pPlay->toBool() ||
+                m_played.contains(location)) {
+            continue;
+        }
+        deck.playedMs += elapsedMs;
+        if (deck.playedMs >= kPlayedThresholdMs) {
+            m_played.insert(location);
+            changed = true;
+        }
+    }
+    if (changed) {
+        emit playedChanged();
+    }
+}
+
+void XdjPlayedTracks::forgetUnder(const QString& directory) {
+    const QString prefix = directory.endsWith(QChar('/'))
+            ? directory
+            : directory + QChar('/');
+    bool changed = false;
+    for (auto it = m_played.begin(); it != m_played.end();) {
+        if (it->startsWith(prefix)) {
+            it = m_played.erase(it);
+            changed = true;
+        } else {
+            ++it;
+        }
+    }
+    // A track still on a deck is off the stick now too; if the stick comes
+    // back, that deck's clock starts again rather than resuming.
+    for (auto& deck : m_decks) {
+        if (deck.location.startsWith(prefix)) {
+            deck.playedMs = 0;
+        }
+    }
+    if (changed) {
+        emit playedChanged();
+    }
+}
diff --git a/src/library/xdjplayedtracks.h b/src/library/xdjplayedtracks.h
new file mode 100644
index 0000000..82ae067
--- /dev/null
+++ b/src/library/xdjplayedtracks.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <QElapsedTimer>
+#include <QObject>
+#include <QSet>
+#include <QString>
+#include <QTimer>
+#include <memory>
+
+class ControlProxy;
+
+/// Pioneered: the tracks played on a deck for at least kPlayedThresholdMs
+/// this session, which the track lists draw greyed out, like the played
+/// history on a Pioneer player. Kept in memory by file location, so it lasts
+/// until the stick the files are on is ejected or pulled (LibraryControl
+/// calls forgetUnder()) or Mixxx restarts. Nothing is written to the
+/// library: Mixxx's own "played" flag is left alone.
+class XdjPlayedTracks : public QObject {
+    Q_OBJECT
+  public:
+    static constexpr qint64 kPlayedThresholdMs = 30 * 1000;
+
+    /// Created on first use and started at once. Lives for the whole run.
+    static XdjPlayedTracks& instance();
+
+    bool isPlayed(const QString& location) const {
+        return !location.isEmpty() && m_played.contains(location);
+    }
+
+    /// Forget every track under this directory (a stick's mount point).
+    void forgetUnder(const QString& directory);
+
+  signals:
+    /// The played set changed; views repaint their text colour.
+    void playedChanged();
+
+  private:
+    static constexpr int kMaxDecks = 4;
+
+    struct DeckState {
+        std::unique_ptr<ControlProxy> pPlay;
+        QString location;
+        qint64 playedMs = 0;
+    };
+
+    XdjPlayedTracks();
+    ~XdjPlayedTracks() override;
+
+    void slotTick();
+
+    QTimer m_timer;
+    QElapsedTimer m_sinceLastTick;
+    DeckState m_decks[kMaxDecks];
+    QSet<QString> m_played;
+};
