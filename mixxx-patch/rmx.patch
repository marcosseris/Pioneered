+void EngineRmx::setRate(int rate) {
+    rate = std::clamp(rate, 0, kNumRates - 1);
+    m_pRate->setAndConfirm(rate);
+    for (int i = 0; i < kNumRates; ++i) {
+        m_rateButtons[i]->setAndConfirm(i == rate ? 1.0 : 0.0);
+    }
+}
+
+void EngineRmx::setMode(bool on) {
+    if (on) {
+        ensureConnections();
+    } else {
+        // Closing the panel lets go of everything: a pad still held as the
+        // panel hides would otherwise keep rolling with nothing on screen.
+        for (auto& pad : m_pads) {
+            pad.pControl->setAndConfirm(0.0);
+        }
+        m_buildSerial.fetch_add(1);
+        m_buildWanted.store(false);
+        m_pBuild->setAndConfirm(0.0);
+    }
+    m_pMode->setAndConfirm(on ? 1.0 : 0.0);
+}
+
+void EngineRmx::ensureConnections() {
+    // The drums always go through the Beat FX, whatever CH SELECT is set
+    // to. The enable is a persisted control, so this only matters the first
+    // time, but it costs nothing to make sure.
+    ControlObject::set(ConfigKey(kBeatFxUnitGroup,
+                               QStringLiteral("group_%1_enable").arg(kInputGroup)),
+            1.0);
+
+    if (m_decksReady.load(std::memory_order_acquire)) {
+        return;
+    }
+    for (int i = 0; i < 2; ++i) {
+        const QString group = QStringLiteral("[Channel%1]").arg(i + 1);
+        m_decks[i] = std::make_unique<DeckProxies>(DeckProxies{
+                PollingControlProxy(group,
+                        QStringLiteral("play"),
+                        ControlFlag::AllowMissingOrInvalid),
+                PollingControlProxy(group,
+                        QStringLiteral("bpm"),
+                        ControlFlag::AllowMissingOrInvalid),
+                PollingControlProxy(group,
+                        QStringLiteral("beat_distance"),
+                        ControlFlag::AllowMissingOrInvalid),
+        });
+    }
+    m_decksReady.store(true, std::memory_order_release);
+}
+
+CSAMPLE EngineRmx::noise() {
+    // xorshift32, white, -1..1
+    m_noiseState ^= m_noiseState << 13;
+    m_noiseState ^= m_noiseState >> 17;
+    m_noiseState ^= m_noiseState << 5;
+    return static_cast<CSAMPLE>(m_noiseState) * (2.0f / 4294967296.0f) - 1.0f;
+}
+
+void EngineRmx::trigger(int padIndex, CSAMPLE_GAIN gain) {
+    Pad& pad = m_pads[padIndex];
+    const double sampleRate = m_sampleRate;
+    Voice* pFree = nullptr;
+    for (auto& voice : pad.voices) {
+        if (voice.active) {
+            // The previous hit gets out of the way quickly but not
+            // instantly, so a fast roll does not click.
+            if (voice.fadeStep == 0.0f) {
+                voice.fadeStep = static_cast<CSAMPLE_GAIN>(
+                        1.0 / (kRetriggerFadeSeconds * sampleRate));
+            }
+        } else if (!pFree) {
+            pFree = &voice;
+        }
+    }
+    if (!pFree) {
+        // All busy (only at the fastest rolls): take the quietest one, which
+        // is the one furthest into its fade.
+        pFree = &*std::min_element(pad.voices.begin(),
+                pad.voices.end(),
+                [](const Voice& a, const Voice& b) {
+                    return a.fade < b.fade;
+                });
+    }
+
+    Voice voice;
+    voice.active = true;
+    voice.sound = static_cast<Sound>(padIndex);
+    voice.gain = gain;
+    double seconds = 0.5;
+    switch (voice.sound) {
+    case Sound::Kick:
+        seconds = 0.7;
+        break;
+    case Sound::Snare:
+        seconds = 0.45;
+        break;
+    case Sound::Clap:
+        seconds = 0.55;
+        break;
+    case Sound::Hat:
+        seconds = 0.22;
+        break;
+    }
+    voice.length = static_cast<SINT>(seconds * sampleRate);
+    *pFree = voice;
+
+    pad.framesSinceHit = 0;
+    pad.hitLightFrames = static_cast<SINT>(kHitLightSeconds * sampleRate);
+}
+
+CSAMPLE EngineRmx::renderVoice(Voice* pVoice, double sampleRate) {
+    Voice& v = *pVoice;
+    const double t = v.frame / sampleRate;
+    const double dt = 1.0 / sampleRate;
+    CSAMPLE out = 0.0f;
+
+    // One-pole high-pass: y[n] = a * (y[n-1] + x[n] - x[n-1])
+    const auto highPass = [dt](CSAMPLE x, CSAMPLE* pIn, CSAMPLE* pOut, double cutoff) {
+        const double rc = 1.0 / (kTwoPi * cutoff);
+        const auto a = static_cast<CSAMPLE>(rc / (rc + dt));
+        const CSAMPLE y = a * (*pOut + x - *pIn);
+        *pIn = x;
+        *pOut = y;
+        return y;
+    };
+
+    switch (v.sound) {
+    case Sound::Kick: {
+        // A sine that drops from ~170 Hz to 48 Hz in the first few tens of
+        // milliseconds, with a short click on top for the beater.
+        const double freq = 48.0 + 120.0 * std::exp(-t / 0.035);
+        v.phase += freq * dt;
+        v.phase -= std::floor(v.phase);
+        const double body = std::sin(kTwoPi * v.phase) * std::exp(-t / 0.3);
+        const double click = noise() * std::exp(-t / 0.0015) * 0.35;
+        out = static_cast<CSAMPLE>(body + click);
+        break;
+    }
+    case Sound::Snare: {
+        // Drum head (190 Hz) plus the wires (high-passed noise).
+        v.phase += 190.0 * dt;
+        v.phase -= std::floor(v.phase);
+        const double head = std::sin(kTwoPi * v.phase) * std::exp(-t / 0.05) * 0.55;
+        const CSAMPLE wires = highPass(noise(), &v.hpIn1, &v.hpOut1, 1200.0);
+        out = static_cast<CSAMPLE>(head + wires * std::exp(-t / 0.12) * 0.75);
+        break;
+    }
+    case Sound::Clap: {
+        // Three quick bursts of band-passed noise, then the room.
+        const double f = 2.0 * std::sin(kPi * 1100.0 * dt);
+        constexpr double kDamping = 0.9;
+        const CSAMPLE x = noise();
+        v.svfLow += static_cast<CSAMPLE>(f) * v.svfBand;
+        const CSAMPLE high = x - v.svfLow - static_cast<CSAMPLE>(kDamping) * v.svfBand;
+        v.svfBand += static_cast<CSAMPLE>(f) * high;
+        double env;
+        if (t < 0.03) {
+            env = std::exp(-std::fmod(t, 0.01) / 0.003);
+        } else {
+            env = std::exp(-(t - 0.03) / 0.12);
+        }
+        out = static_cast<CSAMPLE>(v.svfBand * env * 1.6);
+        break;
+    }
+    case Sound::Hat: {
+        // Noise through two high-passes, short.
+        CSAMPLE x = highPass(noise(), &v.hpIn1, &v.hpOut1, 7000.0);
+        x = highPass(x, &v.hpIn2, &v.hpOut2, 7000.0);
+        out = static_cast<CSAMPLE>(x * std::exp(-t / 0.04) * 0.9);
+        break;
+    }
+    }
+
+    // Last 5 ms fade to silence so the tail never ends on a step.
+    const SINT tailFrames = static_cast<SINT>(0.005 * sampleRate);
+    const SINT left = v.length - v.frame;
+    if (left < tailFrames) {
+        out *= static_cast<CSAMPLE>(left) / tailFrames;
+    }
+
+    out *= v.gain * v.fade;
+    if (v.fadeStep > 0.0f) {
+        v.fade -= v.fadeStep;
+        if (v.fade <= 0.0f) {
+            v.active = false;
+        }
+    }
+    if (++v.frame >= v.length) {
+        v.active = false;
+    }
+    return out;
+}
+
+void EngineRmx::updateClock(SINT frames, double sampleRate, double* pPh0, double* pPh1) {
+    double bpm = 0.0;
+    double beatDistance = 0.0;
+    bool following = false;
+
+    if (m_decksReady.load(std::memory_order_acquire)) {
+        std::array<bool, 2> playing{};
+        for (int i = 0; i < 2; ++i) {
+            playing[i] = m_decks[i]->play.toBool() && m_decks[i]->bpm.get() > 0.0;
+            // The deck that started most recently leads, as for the key
+            // traffic light in the library.
+            if (playing[i] && !m_wasPlaying[i]) {
+                m_masterDeck = i + 1;
+            }
+            m_wasPlaying[i] = playing[i];
+        }
+        if (m_masterDeck == 0 || !playing[m_masterDeck - 1]) {
+            if (playing[0] != playing[1]) {
+                m_masterDeck = playing[0] ? 1 : 2;
+            }
+        }
+        if (m_masterDeck > 0 && playing[m_masterDeck - 1]) {
+            const auto& deck = *m_decks[m_masterDeck - 1];
+            bpm = deck.bpm.get();
+            beatDistance = deck.beatDistance.get();
+            following = true;
+        }
+    }
+
+    if (following) {
+        m_lastBpm = bpm;
+        const double span = frames * bpm / (60.0 * sampleRate);
+        // beat_distance is where the deck is after this buffer, since the
+        // decks have already been processed for it.
+        double ph1 = beatDistance;
+        double ph0 = ph1 - span;
+        if (m_lastPhaseValid) {
+            // Carry on exactly from where the last buffer ended when the deck
+            // has only drifted a little (tempo changes, sync), so a grid line
+            // on the boundary between two buffers is neither missed nor
+            // played twice. A jump (a hot cue, a beat jump) starts afresh.
+            double drift = ph0 - m_lastPhase;
+            drift -= std::round(drift);
+            if (std::fabs(drift) < 0.05) {
+                ph0 -= drift;
+            }
+        }
+        m_lastPhase = ph1;
+        m_lastPhaseValid = true;
+        *pPh0 = ph0;
+        *pPh1 = std::max(ph0, ph1);
+    } else {
+        // Nothing playing: keep the last tempo (120 until a deck has
+        // played) and run on from the last phase.
+        const double span = frames * m_lastBpm / (60.0 * sampleRate);
+        const double ph0 = m_lastPhase;
+        const double ph1 = ph0 + span;
+        m_lastPhase = ph1 - std::floor(ph1);
+        m_lastPhaseValid = true;
+        *pPh0 = ph0;
+        *pPh1 = ph1;
+    }
+
+    const double deck = following ? m_masterDeck : 0.0;
+    if (m_pDeck->get() != deck) {
+        m_pDeck->setAndConfirm(deck);
+    }
+    const double shownBpm = std::round(m_lastBpm * 10.0) / 10.0;
+    if (m_pBpm->get() != shownBpm) {
+        m_pBpm->setAndConfirm(shownBpm);
+    }
+    const double beat = (m_lastPhase < 0.2) ? 1.0 : 0.0;
+    if (m_pBeat->get() != beat) {
+        m_pBeat->setAndConfirm(beat);
+    }
+}
+
+CSAMPLE* EngineRmx::process(int iBufferSize, mixxx::audio::SampleRate sampleRate) {
+    // TODO: remove assumption of stereo buffer (as EngineMixer does)
+    const SINT frames = iBufferSize / 2;
+    const double rate = sampleRate.toDouble();
+    if (rate <= 0.0 || frames <= 0) {
+        return nullptr;
+    }
+    m_sampleRate = rate;
+
+    double ph0 = 0.0;
+    double ph1 = 0.0;
+    updateClock(frames, rate, &ph0, &ph1);
+    const double span = ph1 - ph0;
+    const auto frameAt = [&](double phase) {
+        if (span <= 0.0) {
+            return SINT{0};
+        }
+        return std::clamp(static_cast<SINT>((phase - ph0) / span * frames),
+                SINT{0},
+                frames - 1);
+    };
+
+    // Collect this buffer's hits: {frame, pad, gain}. At most a handful.
+    struct Hit {
+        SINT frame;
+        int pad;
+        CSAMPLE_GAIN gain;
+    };
+    std::array<Hit, 64> hits;
+    int numHits = 0;
+    const auto addHit = [&](SINT frame, int pad, CSAMPLE_GAIN gain) {
+        if (numHits < static_cast<int>(hits.size())) {
+            hits[numHits++] = Hit{frame, pad, gain};
+        }
+    };
+
+    const double stepBeats = kRateBeats[std::clamp(
+            static_cast<int>(m_pRate->get()), 0, kNumRates - 1)];
+    const double beatFrames = span > 0.0 ? frames / span : 0.0;
+    for (int i = 0; i < kNumPads; ++i) {
+        Pad& pad = m_pads[i];
+        const int serial = pad.pressSerial.load();
+        const bool pressed = serial != pad.lastSerial;
+        pad.lastSerial = serial;
+        if (pressed) {
+            // The first hit is immediate: waiting for the grid would feel
+            // like lag under the finger.
+            addHit(0, i, 1.0f);
+        }
+        if (pad.pControl->toBool() && stepBeats > 0.0 && span > 0.0) {
+            // Rolls follow the grid. A grid line that comes less than half a
+            // step after the last hit is skipped, so a press just before a
+            // line does not double up.
+            SINT sinceHit = pressed ? 0 : pad.framesSinceHit;
+            const SINT minGap = static_cast<SINT>(stepBeats * beatFrames * 0.5);
+            SINT lastFrame = 0;
+            for (double line = std::ceil(ph0 / stepBeats) * stepBeats; line < ph1;
+                    line += stepBeats) {
+                const SINT frame = frameAt(line);
+                sinceHit += frame - lastFrame;
+                lastFrame = frame;
+                if (sinceHit >= minGap) {
+                    addHit(frame, i, 1.0f);
+                    sinceHit = 0;
+                }
+            }
+        }
+    }
+
+    // BUILD
+    const int buildSerial = m_buildSerial.load();
+    if (buildSerial != m_lastBuildSerial) {
+        m_lastBuildSerial = buildSerial;
+        m_buildState = m_buildWanted.load() ? BuildState::Waiting : BuildState::Off;
+    }
+    if (m_buildState == BuildState::Waiting && span > 0.0) {
+        // Start on the next beat.
+        const double beat = std::ceil(ph0);
+        if (beat < ph1) {
+            m_buildState = BuildState::Running;
+            m_buildPos = ph0 - beat; // negative: the start is inside this buffer
+        }
+    }
+    if (m_buildState == BuildState::Running && span > 0.0) {
+        const double b0 = m_buildPos;
+        const double b1 = b0 + span;
+        // The steps all divide a beat and change on whole beats, so the
+        // next line is the next multiple of the step we are in.
+        double line = 0.0;
+        if (b0 > 0.0) {
+            const double step = buildStepAt(b0);
+            line = std::ceil(b0 / step) * step;
+        }
+        while (line < b1 && line < kBuildBeats) {
+            const auto gain = static_cast<CSAMPLE_GAIN>(kBuildStartGain +
+                    (1.0 - kBuildStartGain) * line / kBuildBeats);
+            addHit(frameAt(ph0 + (line - b0)), kBuildPad, gain);
+            line += buildStepAt(line);
+        }
+        m_buildPos = b1;
+        if (m_buildPos >= kBuildBeats) {
+            m_buildState = BuildState::Off;
+            m_pBuild->setAndConfirm(0.0);
+        }
+    }
+
+    std::sort(hits.begin(), hits.begin() + numHits, [](const Hit& a, const Hit& b) {
+        return a.frame < b.frame;
+    });
+
+    bool anyVoice = numHits > 0;
+    for (const auto& pad : m_pads) {
+        for (const auto& voice : pad.voices) {
+            anyVoice = anyVoice || voice.active;
+        }
+    }
+
+    // Hit lights and the time since each pad's last hit.
+    for (int i = 0; i < kNumPads; ++i) {
+        Pad& pad = m_pads[i];
+        SINT lastHitFrame = -1;
+        for (int h = 0; h < numHits; ++h) {
+            if (hits[h].pad == i) {
+                lastHitFrame = hits[h].frame;
+            }
+        }
+        if (lastHitFrame >= 0) {
+            pad.framesSinceHit = frames - lastHitFrame;
+            pad.hitLightFrames = static_cast<SINT>(kHitLightSeconds * rate);
+        } else {
+            pad.framesSinceHit += frames;
+            pad.hitLightFrames = std::max(SINT{0}, pad.hitLightFrames - frames);
+        }
+        const double lit = pad.hitLightFrames > 0 ? 1.0 : 0.0;
+        if (pad.pHit->get() != lit) {
+            pad.pHit->setAndConfirm(lit);
+        }
+    }
+
+    const double level = m_pLevel->get() / 100.0;
+    const auto levelGain = static_cast<CSAMPLE_GAIN>(level * level * 0.9);
+    CSAMPLE* pOut = m_buffer.data();
+    if (!anyVoice) {
+        m_levelGainOld = levelGain;
+        if (m_tailFramesLeft <= 0) {
+            return nullptr;
+        }
+        m_tailFramesLeft -= frames;
+        SampleUtil::clear(pOut, iBufferSize);
+        return pOut;
+    }
+    m_tailFramesLeft = static_cast<SINT>(kEffectTailSeconds * rate);
+
+    int nextHit = 0;
+    for (SINT frame = 0; frame < frames; ++frame) {
+        while (nextHit < numHits && hits[nextHit].frame <= frame) {
+            trigger(hits[nextHit].pad, hits[nextHit].gain);
+            ++nextHit;
+        }
+        CSAMPLE sum = 0.0f;
+        for (auto& pad : m_pads) {
+            for (auto& voice : pad.voices) {
+                if (voice.active) {
+                    sum += renderVoice(&voice, rate);
+                }
+            }
+        }
+        pOut[frame * 2] = sum;
+        pOut[frame * 2 + 1] = sum;
+    }
+    SampleUtil::applyRampingGain(pOut, m_levelGainOld, levelGain, iBufferSize);
+    m_levelGainOld = levelGain;
+    return pOut;
+}
+
+GroupFeatureState EngineRmx::features() const {
+    GroupFeatureState features;
+    features.beat_length = GroupFeatureBeatLength{
+            m_sampleRate * 60.0 / m_lastBpm, 1.0};
+    features.beat_fraction_buffer_end = m_lastPhase;
+    return features;
+}
