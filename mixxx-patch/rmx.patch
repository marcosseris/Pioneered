+const QString kGroup = QStringLiteral("[Pioneered]");
+
+// Roll step per rate index, in beats. Index 0 is 1 SHOT: no roll.
+constexpr std::array<double, EngineRmx::kNumRates> kRateBeats = {
+        0.0, 1.0, 0.5, 0.25, 0.125, 0.0625};
+constexpr int kDefaultRate = 3; // 1/4
+constexpr double kDefaultLevel = 80.0;
+constexpr double kLevelStep = 10.0;
+
+// How long a pad stays lit after a hit.
+constexpr double kHitLightSeconds = 0.08;
+// Retrigger fade-out of a pad's previous hit, so a roll does not click.
+constexpr double kRetriggerFadeSeconds = 0.003;
+
+// BUILD: a snare roll over two bars (eight beats) that speeds up and gets
+// louder into the drop, which lands on the beat after it ends.
+constexpr double kBuildBeats = 8.0;
+double buildStepAt(double pos) {
+    if (pos < 4.0) {
+        return 0.5;
+    }
+    if (pos < 6.0) {
+        return 0.25;
+    }
+    if (pos < 7.0) {
+        return 0.125;
+    }
+    return 0.0625;
+}
+constexpr CSAMPLE_GAIN kBuildStartGain = 0.45f;
+constexpr int kBuildPad = 1; // SNARE
+
+constexpr double kPi = 3.14159265358979323846;
+constexpr double kTwoPi = 2.0 * kPi;
+
+// How long silent buffers keep going to the Beat FX after the last hit, so
+// an echo or reverb tail is not cut off.
+constexpr double kEffectTailSeconds = 10.0;
+
+const QString kBeatFxUnitGroup = QStringLiteral("[EffectRack1_EffectUnit1]");
+
