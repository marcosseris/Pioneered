@@ -0,0 +1,169 @@
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+
+#include "audio/types.h"
+#include "control/pollingcontrolproxy.h"
+#include "engine/effects/groupfeaturestate.h"
+#include "util/samplebuffer.h"
+#include "util/types.h"
+
+class ControlObject;
+class ControlPushButton;
+class ControlPotmeter;
+
+/// Pioneered: RMX mode, a few of the RMX-1000's X-PAD tricks. Four drum pads
+/// (KICK, SNARE, CLAP, HAT) that play on the master and in the headphones,
+/// on top of whatever the decks are doing. Holding a pad rolls it at the
+/// ROLL rate, locked to the beat of the master deck (the deck that started
+/// playing most recently); BUILD plays a two-bar snare roll that speeds up
+/// into the drop.
+///
+/// The drums are synthesised here, sample by sample, so there are no sample
+/// files to ship or load and they sound the same at any engine sample rate.
+/// Everything runs in the engine thread: a hit or a roll step lands on the
+/// exact sample of the grid line, which a controller-script timer (20 ms
+/// granularity or worse) could not do.
+///
+/// Controls, all under [Pioneered]:
+///   rmx_mode        1 while the RMX panel is open (toggle)
+///   rmx_pad1..4     1 while the pad is held (push) - KICK, SNARE, CLAP, HAT
+///   rmx_pad1..4_hit flashes 1 for a moment on every hit, for the skin
+///   rmx_rate        0 = 1 SHOT, 1..5 = 1/1, 1/2, 1/4, 1/8, 1/16 beat
+///   rmx_rate_0..5   one per rate: reads 1 while selected, 1 selects it, a 0
+///                   is refused (radio buttons, like the Color FX buttons)
+///   rmx_level       drum level, 0..100
+///   rmx_level_down / rmx_level_up   10 steps down / up
+///   rmx_build       1 while a BUILD is waiting for its beat or running; 1
+///                   starts one, 0 stops it
+///   rmx_deck        the deck the drums follow (0 = none playing)
+///   rmx_bpm         the tempo the drums follow
+///   rmx_beat        1 for the first part of every beat (a beat light)
+///
+/// The drums have their own input to the Beat FX (Effect Unit 1,
+/// kInputGroup), which is switched on whatever the CH SELECT switch says,
+/// so the LEVEL/DEPTH knob puts echo or reverb on them on any channel.
+class EngineRmx : public QObject {
+    Q_OBJECT
+  public:
+    static constexpr int kNumPads = 4;
+    static constexpr int kNumRates = 6;
+    /// The drums' input channel to the effect units.
+    static const QString kInputGroup;
+
+    EngineRmx();
+    ~EngineRmx() override;
+
+    /// Engine thread. Renders one buffer of drums (interleaved stereo,
+    /// iBufferSize samples). Returns nullptr while there is nothing to hear,
+    /// so the mixer can skip it. After the last hit it keeps returning
+    /// (silent) buffers for a while, so an echo or reverb on the drums can
+    /// ring out.
+    CSAMPLE* process(int iBufferSize, mixxx::audio::SampleRate sampleRate);
+
+    /// Engine thread, after process(): the drums' tempo and beat position,
+    /// for tempo-synced effects such as ECHO.
+    GroupFeatureState features() const;
+
+  private:
+    enum class Sound {
+        Kick,
+        Snare,
+        Clap,
+        Hat,
+    };
+
+    struct Voice {
+        bool active = false;
+        Sound sound = Sound::Kick;
+        SINT frame = 0;  // frames since the hit
+        SINT length = 0; // frames until the voice ends by itself
+        CSAMPLE_GAIN gain = 1.0f;
+        CSAMPLE_GAIN fade = 1.0f;     // retrigger fade-out, 1 while not fading
+        CSAMPLE_GAIN fadeStep = 0.0f; // per frame, 0 while not fading
+        double phase = 0.0;           // oscillator phase, in cycles
+        // filter state
+        CSAMPLE hpIn1 = 0.0f;
+        CSAMPLE hpOut1 = 0.0f;
+        CSAMPLE hpIn2 = 0.0f;
+        CSAMPLE hpOut2 = 0.0f;
+        CSAMPLE svfLow = 0.0f;
+        CSAMPLE svfBand = 0.0f;
+    };
+
+    static constexpr int kVoicesPerPad = 3;
+
+    struct Pad {
+        std::unique_ptr<ControlPushButton> pControl;
+        std::unique_ptr<ControlObject> pHit;
+        std::atomic<int> pressSerial{0}; // bumped on every press, any thread
+        int lastSerial = 0;              // engine thread
+        std::array<Voice, kVoicesPerPad> voices;
+        SINT framesSinceHit = 0;
+        SINT hitLightFrames = 0; // frames left of the hit flash
+    };
+
+    void setRate(int rate);
+    void setMode(bool on);
+    void ensureConnections();
+
+    void trigger(int padIndex, CSAMPLE_GAIN gain);
+    CSAMPLE renderVoice(Voice* pVoice, double sampleRate);
+    CSAMPLE noise();
+
+    /// Master-deck beat clock for this buffer: the beat phase at its first
+    /// frame and after its last one (not wrapped, ph0 <= ph1).
+    void updateClock(SINT frames, double sampleRate, double* pPh0, double* pPh1);
+
+    std::unique_ptr<ControlPushButton> m_pMode;
+    std::array<Pad, kNumPads> m_pads;
+    std::unique_ptr<ControlObject> m_pRate;
+    std::array<std::unique_ptr<ControlObject>, kNumRates> m_rateButtons;
+    std::unique_ptr<ControlPotmeter> m_pLevel;
+    std::unique_ptr<ControlPushButton> m_pLevelDown;
+    std::unique_ptr<ControlPushButton> m_pLevelUp;
+    std::unique_ptr<ControlObject> m_pBuild;
+    std::unique_ptr<ControlObject> m_pDeck;
+    std::unique_ptr<ControlObject> m_pBpm;
+    std::unique_ptr<ControlObject> m_pBeat;
+
+    // [ChannelN] play / bpm / beat_distance. The decks do not exist yet
+    // when the mixer is built, so these are made the first time RMX opens
+    // (GUI thread) and published to the engine thread through m_decksReady.
+    struct DeckProxies {
+        PollingControlProxy play;
+        PollingControlProxy bpm;
+        PollingControlProxy beatDistance;
+    };
+    std::array<std::unique_ptr<DeckProxies>, 2> m_decks;
+    std::atomic<bool> m_decksReady{false};
+
+    // engine thread state
+    mixxx::SampleBuffer m_buffer;
+    double m_sampleRate = 48000.0;
+    SINT m_tailFramesLeft = 0; // silent frames still to give the effects
+    std::array<bool, 2> m_wasPlaying{};
+    int m_masterDeck = 0; // 1-based, 0 = none yet
+    double m_lastBpm = 120.0;
+    double m_lastPhase = 0.0; // beat phase after the last buffer, [0, 1)
+    bool m_lastPhaseValid = false;
+    CSAMPLE_GAIN m_levelGainOld = 0.0f;
+    // BUILD requests from any thread: the serial is bumped on every request,
+    // m_buildWanted says whether it was a start or a stop.
+    std::atomic<int> m_buildSerial{0};
+    std::atomic<bool> m_buildWanted{false};
+    int m_lastBuildSerial = 0;
+    enum class BuildState {
+        Off,
+        Waiting, // for the next beat
+        Running,
+    };
+    BuildState m_buildState = BuildState::Off;
+    double m_buildPos = 0.0; // beats since the build started
+    uint32_t m_noiseState = 0x12345678u;
+};
