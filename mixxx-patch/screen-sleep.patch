new file mode 100644
index 0000000..63b2d12
--- /dev/null
+++ b/src/util/screensleep.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <QObject>
+#include <QTimer>
+#include <atomic>
+
+#include "preferences/usersettings.h"
+
+namespace mixxx {
+
+/// Pioneered screen sleep: the XDJ400 runs on a Pi with a touch screen that
+/// is otherwise lit all night. After ScreenSleepMinutes (mixxx.cfg
+/// [Pioneered], default 5, 0 = never) without a touch, without controller
+/// input and without any deck playing, the display is switched off through
+/// X DPMS. Any touch, key or controller input switches it back on.
+///
+/// The touch that wakes the screen is swallowed (press through release), so
+/// tapping a dark screen can never press whatever button was under the
+/// finger.
+///
+/// Controller input arrives on the controller thread, which only stores a
+/// timestamp (noteControllerActivity); the GUI-thread poll timer reads it.
+class ScreenSleep : public QObject {
+    Q_OBJECT
+  public:
+    explicit ScreenSleep(UserSettingsPointer pConfig, QObject* pParent = nullptr);
+    ~ScreenSleep() override;
+
+    /// Thread-safe. Called by Controller::triggerActivity().
+    static void noteControllerActivity();
+
+  protected:
+    bool eventFilter(QObject* pObj, QEvent* pEvent) override;
+
+  private slots:
+    void slotPoll();
+
+  private:
+    bool anyDeckPlaying() const;
+    void noteActivity();
+    void sleepScreen();
+    void wakeScreen();
+    static void runXset(const QString& script);
+    static qint64 nowMs();
+
+    static std::atomic<qint64> s_lastControllerActivityMs;
+
+    QTimer m_pollTimer;
+    qint64 m_timeoutMs;
+    qint64 m_lastActivityMs;
+    qint64 m_sleptAtMs;
+    qint64 m_swallowStartMs;
+    qint64 m_swallowUntilMs;
+    bool m_asleep;
+    bool m_swallowing;
+    bool m_releaseSeen;
+};
+
+} // namespace mixxx
