diff --git a/src/util/screensleep.cpp b/src/util/screensleep.cpp
new file mode 100644
index 0000000..a6e6f95
--- /dev/null
+++ b/src/util/screensleep.cpp
@@ -0,0 +1,235 @@
+#include "util/screensleep.h"
+
+#include <QCoreApplication>
+#include <QEvent>
+#include <QProcess>
+#include <QStringList>
+#include <QtDebug>
+#include <chrono>
+
+#include "control/controlobject.h"
+#include "mixer/playermanager.h"
+#include "moc_screensleep.cpp"
+
+namespace mixxx {
+
+namespace {
+
+const ConfigKey kScreenSleepMinutesKey(
+        QStringLiteral("[Pioneered]"), QStringLiteral("ScreenSleepMinutes"));
+constexpr int kDefaultScreenSleepMinutes = 5;
+
+// Often enough that a jog touch wakes the screen without a noticeable lag;
+// each poll is a handful of control reads.
+constexpr int kPollIntervalMs = 250;
+
+// After the waking press is released, keep swallowing for a moment: Qt can
+// deliver a touch both as touch events and as synthesized mouse events, and
+// a second finger landing during the wake must not reach the skin either.
+constexpr qint64 kSwallowGraceMs = 400;
+// Safety net: never swallow input for longer than this, even if the
+// release of the waking press is somehow never seen.
+constexpr qint64 kSwallowMaxMs = 5000;
+
+// X commands, run through /bin/sh. DPMS really powers the panel down, but
+// Raspberry Pi OS ships the DPMS extension disabled when "screen blanking"
+// is off in raspi-config (/etc/X11/xorg.conf.d/10-blanking.conf; the
+// Pioneered updater re-enables it with every X timer at 0). Without it,
+// fall back to the X screen saver's blanking: black, backlight still on.
+// Either way X itself switches the display back on at the next input.
+//
+// Startup: X never blanks or powers down on its own timers; Mixxx decides.
+const QString kXsetInit = QStringLiteral(
+        "xset s off; xset s noexpose; xset dpms 0 0 0 2>/dev/null; true");
+const QString kXsetSleep = QStringLiteral(
+        "if xset q 2>/dev/null | grep -q '^ *DPMS is'; then "
+        "xset +dpms; xset dpms 0 0 0; xset dpms force off; "
+        "else xset s activate; fi");
+const QString kXsetWake = QStringLiteral(
+        "xset dpms force on 2>/dev/null; xset s reset");
+
+enum class InputKind {
+    None,
+    Press,
+    Release,
+    Move,
+};
+
+InputKind classify(QEvent::Type type) {
+    switch (type) {
+    case QEvent::MouseButtonPress:
+    case QEvent::MouseButtonDblClick:
+    case QEvent::TouchBegin:
+    case QEvent::TabletPress:
+    case QEvent::KeyPress:
+        return InputKind::Press;
+    case QEvent::MouseButtonRelease:
+    case QEvent::TouchEnd:
+    case QEvent::TouchCancel:
+    case QEvent::TabletRelease:
+    case QEvent::KeyRelease:
+        return InputKind::Release;
+    case QEvent::MouseMove:
+    case QEvent::TouchUpdate:
+    case QEvent::TabletMove:
+    case QEvent::Wheel: // no release follows; activity only
+        return InputKind::Move;
+    default:
+        return InputKind::None;
+    }
+}
+
+} // namespace
+
+std::atomic<qint64> ScreenSleep::s_lastControllerActivityMs{0};
+
+qint64 ScreenSleep::nowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+}
+
+void ScreenSleep::noteControllerActivity() {
+    s_lastControllerActivityMs.store(nowMs(), std::memory_order_relaxed);
+}
+
+ScreenSleep::ScreenSleep(UserSettingsPointer pConfig, QObject* pParent)
+        : QObject(pParent),
+          m_timeoutMs(0),
+          m_lastActivityMs(nowMs()),
+          m_sleptAtMs(0),
+          m_swallowStartMs(0),
+          m_swallowUntilMs(0),
+          m_asleep(false),
+          m_swallowing(false),
+          m_releaseSeen(false) {
+    if (!pConfig->exists(kScreenSleepMinutesKey)) {
+        // Written out so the setting can be found (and changed) in mixxx.cfg.
+        pConfig->setValue(kScreenSleepMinutesKey, kDefaultScreenSleepMinutes);
+    }
+    const int minutes = pConfig->getValue(
+            kScreenSleepMinutesKey, kDefaultScreenSleepMinutes);
+    if (minutes <= 0) {
+        qInfo() << "Screen sleep: off ([Pioneered] ScreenSleepMinutes =" << minutes << ")";
+        return;
+    }
+    m_timeoutMs = static_cast<qint64>(minutes) * 60 * 1000;
+    qInfo() << "Screen sleep: display off after" << minutes << "min idle";
+
+    // Mixxx alone decides when the screen sleeps: stop the X server's own
+    // blanking and DPMS timers, which know nothing about the controller or
+    // a playing deck.
+    runXset(kXsetInit);
+
+    QCoreApplication::instance()->installEventFilter(this);
+    m_pollTimer.setInterval(kPollIntervalMs);
+    connect(&m_pollTimer, &QTimer::timeout, this, &ScreenSleep::slotPoll);
+    m_pollTimer.start();
+}
+
+ScreenSleep::~ScreenSleep() {
+    if (m_asleep) {
+        // Never leave the screen dark behind a closing Mixxx.
+        runXset(kXsetWake);
+    }
+}
+
+bool ScreenSleep::anyDeckPlaying() const {
+    const int numDecks = static_cast<int>(PlayerManager::numDecks());
+    for (int i = 0; i < numDecks; ++i) {
+        if (ControlObject::get(ConfigKey(PlayerManager::groupForDeck(i),
+                    QStringLiteral("play"))) > 0.0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void ScreenSleep::noteActivity() {
+    m_lastActivityMs = nowMs();
+}
+
+void ScreenSleep::slotPoll() {
+    const qint64 now = nowMs();
+    const qint64 controllerMs =
+            s_lastControllerActivityMs.load(std::memory_order_relaxed);
+    if (controllerMs > m_lastActivityMs) {
+        m_lastActivityMs = controllerMs;
+    }
+    if (anyDeckPlaying()) {
+        m_lastActivityMs = now;
+    }
+    if (m_asleep) {
+        if (m_lastActivityMs > m_sleptAtMs) {
+            // Controller input or a deck started: the controller action
+            // itself goes through, there is nothing on screen to protect.
+            wakeScreen();
+        }
+        return;
+    }
+    if (now - m_lastActivityMs >= m_timeoutMs) {
+        sleepScreen();
+    }
+}
+
+void ScreenSleep::sleepScreen() {
+    m_asleep = true;
+    m_sleptAtMs = nowMs();
+    qInfo() << "Screen sleep: display off";
+    runXset(kXsetSleep);
+}
+
+void ScreenSleep::wakeScreen() {
+    if (!m_asleep) {
+        return;
+    }
+    m_asleep = false;
+    noteActivity();
+    qInfo() << "Screen sleep: display on";
+    runXset(kXsetWake);
+}
+
+void ScreenSleep::runXset(const QString& script) {
+    // Detached: xset returns at once, and the GUI thread never waits on it.
+    QProcess::startDetached(QStringLiteral("/bin/sh"),
+            {QStringLiteral("-c"), script});
+}
+
+bool ScreenSleep::eventFilter(QObject* pObj, QEvent* pEvent) {
+    const InputKind kind = classify(pEvent->type());
+    if (kind == InputKind::None) {
+        return QObject::eventFilter(pObj, pEvent);
+    }
+    noteActivity();
+
+    if (m_asleep) {
+        // X switches the display back on by itself at any input; keep our
+        // state in step with it.
+        wakeScreen();
+        if (kind == InputKind::Press) {
+            // The touch that woke the screen must not press the button
+            // that happened to be under the finger.
+            m_swallowing = true;
+            m_releaseSeen = false;
+            m_swallowStartMs = nowMs();
+            m_swallowUntilMs = m_swallowStartMs + kSwallowGraceMs;
+            return true;
+        }
+    }
+
+    if (m_swallowing) {
+        const qint64 now = nowMs();
+        if ((m_releaseSeen && now >= m_swallowUntilMs) ||
+                now - m_swallowStartMs >= kSwallowMaxMs) {
+            m_swallowing = false;
+        } else {
+            if (kind == InputKind::Release) {
+                m_releaseSeen = true;
+            }
+            return true;
+        }
+    }
+    return QObject::eventFilter(pObj, pEvent);
+}
+
+} // namespace mixxx
