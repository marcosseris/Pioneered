+void WSearchLineEdit::hideEvent(QHideEvent* event) {
+    // Pioneered: the Search and Browse pages share one track table, so a
+    // query typed on the Search page used to keep filtering Browse too. When
+    // the Search page is swapped out (the window itself stays up), park the
+    // query and show the unfiltered list; showEvent() re-runs it.
+    // Skip when the whole window is closing/minimised.
+    if (!event->spontaneous() && window()->isVisible() && isEnabled()) {
+        m_debouncingTimer.stop();
+        const QString text = getSearchText();
+        if (!text.isEmpty()) {
+            slotSaveSearch();
+            m_hiddenSearchText = text;
+            emit search(QString());
+        }
+    }
+    QComboBox::hideEvent(event);
+}
+
+void WSearchLineEdit::showEvent(QShowEvent* event) {
+    QComboBox::showEvent(event);
+    // Re-run the parked query over whatever is selected now. If the current
+    // view has no search (box disabled), keep it parked for next time.
+    if (!m_hiddenSearchText.isEmpty() && isEnabled()) {
+        slotSetSearchText(std::exchange(m_hiddenSearchText, QString()));
+    }
+}
