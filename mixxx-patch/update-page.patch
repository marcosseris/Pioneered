+void LibraryControl::bindUpdatePanel(WUpdatePanel* pPanel) {
+    if (m_pUpdatePanel) {
+        disconnect(m_pUpdatePanel, nullptr, this, nullptr);
+    }
+    m_pUpdatePanel = pPanel;
+    connect(m_pUpdatePanel,
+            &WUpdatePanel::destroyed,
+            this,
+            &LibraryControl::updatePanelDeleted);
+    connect(m_pUpdatePanel,
+            &WUpdatePanel::runningChanged,
+            this,
+            [this](bool running) {
+                m_pUpdateRunning->setAndConfirm(running ? 1.0 : 0.0);
+                if (running) {
+                    m_pUpdateDone->setAndConfirm(0.0);
+                }
+            });
+    connect(m_pUpdatePanel,
+            &WUpdatePanel::finishedOk,
+            this,
+            [this](bool ok) {
+                m_pUpdateDone->setAndConfirm(ok ? 1.0 : 0.0);
+            });
+}
+
+void LibraryControl::updatePanelDeleted() {
+    m_pUpdatePanel = nullptr;
+}
+
+void LibraryControl::openUpdatePage() {
+    m_disarmTimer.stop();
+    m_pArmPower->setAndConfirm(0.0);
+    m_pArmRestart->setAndConfirm(0.0);
+    m_pUpdateArm->setAndConfirm(0.0);
+    m_pUpdatePage->setAndConfirm(1.0);
+    updateSubpageControl();
+    if (m_pUpdatePanel) {
+        m_pUpdatePanel->open();
+    }
+}
+
+void LibraryControl::closeUpdatePage() {
+    // A running update is deliberately left running; only the page goes away.
+    if (m_pUpdatePanel) {
+        m_pUpdatePanel->close();
+    }
+    m_pUpdateArm->setAndConfirm(0.0);
+    m_pUpdatePage->setAndConfirm(0.0);
+    updateSubpageControl();
+}
+
+void LibraryControl::updateSubpageControl() {
+    const bool anyOpen = m_pWifiPage->get() > 0.0 || m_pUpdatePage->get() > 0.0;
+    m_pMenuSubpage->setAndConfirm(anyOpen ? 1.0 : 0.0);
+}
+
+void LibraryControl::slotUpdateRun(double v) {
+    if (v <= 0.0) {
+        return; // arm/commit on press, as the settings menu does
+    }
+    if (!m_pUpdatePanel || m_pUpdatePanel->isRunning()) {
+        return;
+    }
+    if (m_pUpdateArm->get() > 0.0) {
+        m_disarmTimer.stop();
+        m_pUpdateArm->setAndConfirm(0.0);
+        m_pUpdatePanel->run();
+        return;
+    }
+    m_pUpdateArm->setAndConfirm(1.0);
+    m_disarmTimer.start();
+}
+
+void LibraryControl::triggerReboot() {
+    if (m_rebootTriggered) {
+        return;
+    }
+    m_rebootTriggered = true;
+    showBanner(m_pRestarting.get());
+    // Same ladder as the settings menu's power off: logind first, then the
+    // passwordless sudo the rest of the Pi integration already relies on.
+    const QString script = QStringLiteral(
+            "systemctl reboot || sudo -n reboot || sudo -n shutdown -r now");
+    qWarning() << "Settings menu: rebooting:" << script;
+    auto* pProcess = new QProcess(this);
+    connect(pProcess,
+            QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this,
+            [this, pProcess](int exitCode, QProcess::ExitStatus exitStatus) {
+                pProcess->deleteLater();
+                if (exitStatus == QProcess::NormalExit && exitCode == 0) {
+                    return; // reboot queued; the banner rides it out
+                }
+                m_rebootTriggered = false;
+                showBanner(m_pPowerOffFailed.get());
+            });
+    connect(pProcess,
+            &QProcess::errorOccurred,
+            this,
+            [this, pProcess](QProcess::ProcessError error) {
+                if (error == QProcess::FailedToStart) {
+                    pProcess->deleteLater();
+                    m_rebootTriggered = false;
+                    showBanner(m_pPowerOffFailed.get());
+                }
+            });
+    pProcess->start(QStringLiteral("/bin/sh"),
+            {QStringLiteral("-c"), script});
 }
 
