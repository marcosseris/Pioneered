diff --git a/src/widget/wupdatepanel.h b/src/widget/wupdatepanel.h
new file mode 100644
--- /dev/null
+++ b/src/widget/wupdatepanel.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <QString>
+#include <QWidget>
+
+#include "widget/wbasewidget.h"
+
+class QDomNode;
+class QLabel;
+class QPlainTextEdit;
+class QProcess;
+class SkinContext;
+
+/// Pioneered software-update page: runs the on-Pi updater and shows its
+/// terminal output live, so an update can be done from the touchscreen
+/// instead of an ssh session.
+///
+/// The command is fixed in C++ rather than taken from the skin on purpose:
+/// this runs as root, and a skin is just a folder of XML a user can drop in.
+/// The updater is the one at kUpdateScript, installed there by the updater
+/// itself from r29 on.
+///
+/// Like WWifiPanel, this widget is only the dynamic part. BACK, UPDATE and
+/// REBOOT are ordinary skin buttons pressing [Library],update_* controls that
+/// LibraryControl forwards here (see LibraryControl::bindUpdatePanel); the
+/// widget reports back what the skin needs to lay itself out.
+class WUpdatePanel : public QWidget, public WBaseWidget {
+    Q_OBJECT
+  public:
+    explicit WUpdatePanel(QWidget* pParent = nullptr);
+    ~WUpdatePanel() override;
+
+    void setup(const QDomNode& node, const SkinContext& context);
+
+    void open();  // page shown
+    void close(); // page hidden (a running update is left running)
+    void run();   // start the updater
+    bool isRunning() const;
+
+  signals:
+    /// True while the updater is running: the skin hides UPDATE and BACK.
+    void runningChanged(bool running);
+    /// Emitted once the updater exits; ok means "restart to finish".
+    void finishedOk(bool ok);
+
+  private:
+    void append(const QString& text);
+    void appendNotice(const QString& line);
+    void readFromProcess();
+    void processFinished(int exitCode, bool crashed);
+    void setStatus(const QString& text, const char* state);
+
+    QLabel* m_pStatus;
+    QPlainTextEdit* m_pOutput;
+    QProcess* m_pProcess;
+    /// Tail of a partial line held back until its newline arrives, so a
+    /// progress line split across two reads is not shown twice.
+    QString m_pending;
+    bool m_sawFailure;
+};
diff --git a/src/widget/wupdatepanel.cpp b/src/widget/wupdatepanel.cpp
new file mode 100644
--- /dev/null
+++ b/src/widget/wupdatepanel.cpp
@@ -0,0 +1,202 @@
+#include "widget/wupdatepanel.h"
+
+#include <QLabel>
+#include <QPlainTextEdit>
+#include <QProcess>
+#include <QRegularExpression>
+#include <QScrollBar>
+#include <QScroller>
+#include <QStyle>
+#include <QVBoxLayout>
+#include <QtDebug>
+
+#include "moc_wupdatepanel.cpp"
+#include "skin/legacy/skincontext.h"
+
+namespace {
+
+/// Installed there by pi/update-pioneered.sh itself (r29 and later), so the
+/// path is stable whatever folder the operator originally ran it from.
+const QString kUpdateScript = QStringLiteral("/usr/local/bin/update-pioneered.sh");
+
+constexpr int kMaxLogBlocks = 2000;
+
+} // namespace
+
+WUpdatePanel::WUpdatePanel(QWidget* pParent)
+        : QWidget(pParent),
+          WBaseWidget(this),
+          m_pProcess(nullptr),
+          m_sawFailure(false) {
+    setAttribute(Qt::WA_StyledBackground, true);
+
+    auto* pLayout = new QVBoxLayout(this);
+    pLayout->setContentsMargins(0, 0, 0, 0);
+    pLayout->setSpacing(4);
+
+    m_pStatus = new QLabel(this);
+    m_pStatus->setObjectName(QStringLiteral("UpdateStatus"));
+    m_pStatus->setAlignment(Qt::AlignCenter);
+    m_pStatus->setWordWrap(true);
+    pLayout->addWidget(m_pStatus);
+
+    m_pOutput = new QPlainTextEdit(this);
+    m_pOutput->setObjectName(QStringLiteral("UpdateLog"));
+    m_pOutput->setReadOnly(true);
+    m_pOutput->setFocusPolicy(Qt::NoFocus);
+    m_pOutput->setLineWrapMode(QPlainTextEdit::NoWrap);
+    m_pOutput->setTextInteractionFlags(Qt::NoTextInteraction);
+    // A long apt run would otherwise grow without bound on a 1 GB Pi.
+    m_pOutput->setMaximumBlockCount(kMaxLogBlocks);
+    // Drag the log with a finger; there is no scroll wheel on this unit and
+    // the scrollbar is far too thin to hit reliably on a touchscreen.
+    QScroller::grabGesture(m_pOutput->viewport(), QScroller::LeftMouseButtonGesture);
+    pLayout->addWidget(m_pOutput, 1);
+
+    setStatus(QStringLiteral("TAP UPDATE TO CHECK FOR A NEW VERSION"), "idle");
+}
+
+WUpdatePanel::~WUpdatePanel() {
+    // Never kill a running apt: leaving dpkg half-done would be far worse
+    // than losing the window. Detach and let it finish.
+    if (m_pProcess) {
+        m_pProcess->disconnect(this);
+    }
+}
+
+void WUpdatePanel::setup(const QDomNode& node, const SkinContext& context) {
+    Q_UNUSED(node);
+    Q_UNUSED(context);
+}
+
+bool WUpdatePanel::isRunning() const {
+    return m_pProcess != nullptr;
+}
+
+void WUpdatePanel::open() {
+    if (!m_pProcess) {
+        m_pOutput->clear();
+        m_sawFailure = false;
+        setStatus(QStringLiteral("TAP UPDATE TO CHECK FOR A NEW VERSION"), "idle");
+    }
+}
+
+void WUpdatePanel::close() {
+    // Deliberately does not stop a running update.
+}
+
+void WUpdatePanel::run() {
+    if (m_pProcess) {
+        return;
+    }
+    m_sawFailure = false;
+    m_pending.clear();
+    m_pOutput->clear();
+    setStatus(QStringLiteral("UPDATING… DO NOT POWER OFF"), "running");
+
+    m_pProcess = new QProcess(this);
+    // The updater writes progress to both streams; the operator wants one
+    // transcript, in order, exactly as it would look in a terminal.
+    m_pProcess->setProcessChannelMode(QProcess::MergedChannels);
+    connect(m_pProcess,
+            &QProcess::readyRead,
+            this,
+            &WUpdatePanel::readFromProcess);
+    connect(m_pProcess,
+            QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this,
+            [this](int exitCode, QProcess::ExitStatus status) {
+                processFinished(exitCode, status != QProcess::NormalExit);
+            });
+    connect(m_pProcess,
+            &QProcess::errorOccurred,
+            this,
+            [this](QProcess::ProcessError error) {
+                if (error == QProcess::FailedToStart) {
+                    processFinished(-1, true);
+                }
+            });
+
+    // -n so a missing sudoers rule fails immediately with a readable message
+    // instead of blocking forever on a password prompt no one can answer:
+    // there is no terminal behind this window.
+    appendNotice(QStringLiteral("$ sudo -n %1 --no-reboot").arg(kUpdateScript));
+    emit runningChanged(true);
+    m_pProcess->start(QStringLiteral("sudo"),
+            {QStringLiteral("-n"), kUpdateScript, QStringLiteral("--no-reboot")});
+}
+
+void WUpdatePanel::readFromProcess() {
+    if (!m_pProcess) {
+        return;
+    }
+    m_pending += QString::fromUtf8(m_pProcess->readAll());
+    // apt draws progress with carriage returns; treat them as line breaks so
+    // the log reads top to bottom instead of overwriting itself.
+    m_pending.replace(QLatin1Char('\r'), QLatin1Char('\n'));
+    int newline = m_pending.indexOf(QLatin1Char('\n'));
+    while (newline >= 0) {
+        append(m_pending.left(newline));
+        m_pending = m_pending.mid(newline + 1);
+        newline = m_pending.indexOf(QLatin1Char('\n'));
+    }
+}
+
+void WUpdatePanel::processFinished(int exitCode, bool crashed) {
+    if (!m_pending.isEmpty()) {
+        append(m_pending);
+        m_pending.clear();
+    }
+    const bool ok = !crashed && exitCode == 0 && !m_sawFailure;
+    if (m_pProcess) {
+        m_pProcess->deleteLater();
+        m_pProcess = nullptr;
+    }
+    emit runningChanged(false);
+    if (ok) {
+        setStatus(QStringLiteral("UPDATE INSTALLED — TAP RESTART TO FINISH"), "ok");
+    } else if (crashed) {
+        appendNotice(QStringLiteral(
+                "could not run the updater. If this says it is not installed, "
+                "run it once by hand; if it says a password is required, add "
+                "the sudoers rule from the README."));
+        setStatus(QStringLiteral("UPDATE COULD NOT START"), "failed");
+    } else {
+        setStatus(QStringLiteral("UPDATE FAILED (exit %1) — NOTHING CHANGED")
+                          .arg(exitCode),
+                "failed");
+    }
+    emit finishedOk(ok);
+}
+
+void WUpdatePanel::append(const QString& text) {
+    QString line = text;
+    // The updater is a plain shell script, but apt emits the odd escape.
+    static const QRegularExpression kAnsi(
+            QStringLiteral("\x1b\\[[0-9;?]*[A-Za-z]"));
+    line.remove(kAnsi);
+    if (line.trimmed().isEmpty()) {
+        return;
+    }
+    if (line.contains(QStringLiteral("ERROR"), Qt::CaseSensitive) ||
+            line.startsWith(QStringLiteral("E: "))) {
+        m_sawFailure = true;
+    }
+    m_pOutput->appendPlainText(line);
+    m_pOutput->verticalScrollBar()->setValue(
+            m_pOutput->verticalScrollBar()->maximum());
+}
+
+void WUpdatePanel::appendNotice(const QString& line) {
+    m_pOutput->appendPlainText(line);
+    m_pOutput->verticalScrollBar()->setValue(
+            m_pOutput->verticalScrollBar()->maximum());
+}
+
+void WUpdatePanel::setStatus(const QString& text, const char* state) {
+    m_pStatus->setText(text);
+    m_pStatus->setProperty("state", QString::fromLatin1(state));
+    m_pStatus->style()->unpolish(m_pStatus);
+    m_pStatus->style()->polish(m_pStatus);
+    m_pStatus->update();
+}
