+bool LibraryControl::isRekordboxStickMounted(int usbIndex) {
+    const QString mountPath = usbMountPath(usbIndex);
+    const QStorageInfo storage(mountPath);
+    if (!storage.isValid() || !storage.isReady() ||
+            storage.rootPath() != mountPath) {
+        return false;
+    }
+    // Only a rekordbox export can be browsed; any other stick is left alone
+    // (the device scan would not list it anyway).
