+        return; // a parse for a stick the sidebar is not waiting on
+    }
+    if (m_rootedUsb == 0 || !m_rootedDeviceIndex.isValid() ||
+            !m_pSidebarWidget) {
+        m_rootAwaitingPlaylists = false;
+        return;
+    }
+    SidebarModel* pSidebarModel = m_pLibrary->sidebarModel();
+    const QModelIndex deviceIndex(m_rootedDeviceIndex);
+    if (pSidebarModel->rowCount(deviceIndex) == 0) {
+        return; // a different stick's parse finished; keep waiting
+    }
+    m_rootAwaitingPlaylists = false;
+    // The parse attached the playlists on a worker thread without telling the
+    // model's views, so the view rooted here is still showing the empty list
+    // it laid out when the stick was rooted. Re-applying the root makes it lay
+    // out again. This is what used to take two more presses: one that
+    // un-rooted (showing the whole Mixxx tree) and one that rooted again.
+    m_pSidebarWidget->setRootIndex(deviceIndex);
+    const QModelIndex firstChild = pSidebarModel->index(0, 0, deviceIndex);
+    if (firstChild.isValid()) {
+        m_pSidebarWidget->selectIndex(firstChild);
     }
 }
 
