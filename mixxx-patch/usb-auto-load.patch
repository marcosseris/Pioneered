+
+void LibraryControl::slotPollUsbMounts() {
+    for (int usbIndex = 1; usbIndex <= 2; ++usbIndex) {
+        bool& wasMounted = m_usbMounted[usbIndex - 1];
+        const bool mounted = isRekordboxStickMounted(usbIndex);
+        if (mounted == wasMounted) {
+            continue;
+        }
+        if (!mounted) {
+            // Pulled or ejected. Drop its row from the device list; if the
+            // sidebar was showing it, rowsRemoved -> validateSidebarRoot()
+            // takes the sidebar back to the stick list.
+            wasMounted = false;
+            refreshRekordboxDevices();
+            continue;
+        }
+        // A new stick. Hold off while the skin's sidebar does not exist yet
+        // (a stick that was in at boot) or a USB hold/eject owns the sidebar;
+        // it is not marked as seen, so the next tick tries again.
+        if (!m_pSidebarWidget || m_holdUsb != 0 || m_ejectRunning) {
+            continue;
         }
+        wasMounted = true;
+        if (m_pendingUsb != 0 && m_pendingUsb != usbIndex) {
+            // Both sticks turned up together (both in at boot): the first one
+            // is already on its way, so this one waits for its button.
+            continue;
+        }
+        browseUsb(usbIndex);
+    }
+}
+
+void LibraryControl::slotRekordboxDevicePlaylistsReady() {
