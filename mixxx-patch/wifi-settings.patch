+    QString m_entryText;
+    Network m_entryNetwork;
+    QString m_armedForget; // SSID whose row reads "TAP AGAIN TO FORGET"
+    QTimer m_forgetDisarmTimer;
+    QTimer m_statusTimer;
+    QString m_wifiDevice;
+};
