+void LibraryControl::bindWifiPanel(WWifiPanel* pPanel) {
+    if (m_pWifiPanel) {
+        disconnect(m_pWifiPanel, nullptr, this, nullptr);
+    }
+    m_pWifiPanel = pPanel;
+    connect(m_pWifiPanel,
+            &WWifiPanel::destroyed,
+            this,
+            &LibraryControl::wifiPanelDeleted);
+    connect(m_pWifiPanel,
+            &WWifiPanel::entryModeChanged,
+            this,
+            [this](bool entry) {
+                m_pWifiEntry->setAndConfirm(entry ? 1.0 : 0.0);
+            });
+    connect(m_pWifiPanel,
+            &WWifiPanel::closeRequested,
+            this,
+            &LibraryControl::closeWifiPage);
+}
+
+void LibraryControl::wifiPanelDeleted() {
+    m_pWifiPanel = nullptr;
+}
+
+void LibraryControl::openWifiPage() {
+    // Opening the page clears any armed confirm on the menu underneath, so
+    // nothing is left one tap from a shutdown behind the Wi-Fi list.
+    m_disarmTimer.stop();
+    m_pArmPower->setAndConfirm(0.0);
+    m_pArmRestart->setAndConfirm(0.0);
+    m_pWifiPage->setAndConfirm(1.0);
+    if (m_pWifiPanel) {
+        m_pWifiPanel->open();
+    }
+}
+
+void LibraryControl::closeWifiPage() {
+    if (m_pWifiPanel) {
+        m_pWifiPanel->close(); // also leaves password entry
+    }
+    m_pWifiEntry->setAndConfirm(0.0);
+    m_pWifiPage->setAndConfirm(0.0);
+}
