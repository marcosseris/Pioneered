+/// Pioneered Wi-Fi settings page body: the dynamic part (network list,
+/// connection status, the password being typed) of the Wi-Fi page reached
+/// from the settings menu. Everything static around it -- BACK, RESCAN,
+/// paging, the on-screen keyboard -- is ordinary skin buttons pressing
+/// [Library],wifi_* controls that LibraryControl forwards here (see
+/// LibraryControl::bindWifiPanel), the same way the search box receives the
+/// search keyboard. The widget in turn reports the two facts the skin needs
+/// to lay itself out (password entry open or not, page done) as signals.
+///
+/// Networking goes through NetworkManager's nmcli, always asynchronously:
+/// a scan can take several seconds and the GUI thread must never wait on it.
+class WWifiPanel : public QWidget, public WBaseWidget {
+    Q_OBJECT
+  public:
+    explicit WWifiPanel(QWidget* pParent = nullptr);
+    ~WWifiPanel() override = default;
+
+    void setup(const QDomNode& node, const SkinContext& context);
+
+    // Entry points driven by LibraryControl from the [Library],wifi_* controls.
+    void open();         // page shown: refresh status and scan
+    void close();        // page hidden: leave entry, drop pending results
+    void back();         // BACK: leaves password entry, else asks to close
+    void rescan();
+    void prevPage();
+    void nextPage();
+    void confirmEntry(); // CONNECT with the typed password
+    void appendText(const QString& text);
+    void backspace();
+    void clearText();
+
+  signals:
+    void entryModeChanged(bool entry);
+    void closeRequested();
+
+  private:
+    struct Network {
+        QString ssid;
+        int signal = 0;
+        bool secured = false;
+        bool enterprise = false;
+        bool inUse = false;
+        bool saved = false;
+    };
+    using NmcliDone = std::function<void(
+            int exitCode, const QString& out, const QString& err)>;
+
+    void runNmcli(const QStringList& args,
+            NmcliDone done,
+            bool sudoRetry = false,
+            bool viaSudo = false);
+    static QStringList splitTerse(const QString& line);
+    static QString signalBars(int signal);
+
+    void refreshStatus();
+    void startScan();
+    void listNetworks(int generation, const QString& savedOut, bool rescan);
+    void parseScan(const QString& savedOut, const QString& scanOut);
+    void renderList();
+    void rowTapped(int row);
+    void beginEntry(const Network& network, const QString& hint);
+    void endEntry();
+    void startConnect(const Network& network, const QString& password);
+    void forgetNetwork(const QString& ssid);
+    void setHint(const QString& text, bool error = false);
+    void setEntryHint(const QString& text, bool error = false);
+    void setRowState(QPushButton* pRow, const char* state);
+    void refreshEntryText();
+    static void restyle(QWidget* pWidget);
