+// ---------------------------------------------------------------- nmcli ---
+
+void WWifiPanel::runNmcli(const QStringList& args,
+        NmcliDone done,
+        bool sudoRetry,
+        bool viaSudo) {
+    auto* pProcess = new QProcess(this);
+    connect(pProcess,
+            QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this,
+            [this, pProcess, args, done, sudoRetry, viaSudo](
+                    int exitCode, QProcess::ExitStatus exitStatus) {
+                pProcess->deleteLater();
+                const QString out = QString::fromUtf8(
+                        pProcess->readAllStandardOutput());
+                const QString err = QString::fromUtf8(
+                        pProcess->readAllStandardError())
+                                            .trimmed();
+                if (exitStatus != QProcess::NormalExit) {
+                    exitCode = -1;
+                }
+                if (exitCode != 0 && sudoRetry && !viaSudo &&
+                        looksLikePermissionError(err)) {
+                    // polkit refused the session; the README documents a
+                    // passwordless sudo rule for nmcli as the fallback.
+                    qWarning() << "Wi-Fi: nmcli refused, retrying via sudo:" << err;
+                    runNmcli(args, done, sudoRetry, true);
+                    return;
+                }
+                if (exitCode != 0) {
+                    qWarning() << "Wi-Fi: nmcli" << args << "failed:" << exitCode << err;
+                }
+                done(exitCode, out, err);
+            });
+    connect(pProcess,
+            &QProcess::errorOccurred,
+            this,
+            [pProcess, done](QProcess::ProcessError error) {
+                // finished() never fires for a process that failed to start.
+                if (error == QProcess::FailedToStart) {
+                    pProcess->deleteLater();
+                    done(-2, QString(), QStringLiteral("nmcli not found"));
+                }
+            });
+    if (viaSudo) {
+        pProcess->start(QStringLiteral("sudo"),
+                QStringList() << QStringLiteral("-n") << kNmcli << args);
+    } else {
+        pProcess->start(kNmcli, args);
+    }
+}
+
+// nmcli -t separates fields with ':' and escapes ':' and backslash in values
+// with a backslash (--escape yes). Undo that while splitting.
+// static
+QStringList WWifiPanel::splitTerse(const QString& line) {
+    QStringList fields;
+    QString current;
+    for (int i = 0; i < line.size(); ++i) {
+        const QChar c = line.at(i);
+        if (c == QLatin1Char('\\') && i + 1 < line.size()) {
+            current.append(line.at(++i));
+        } else if (c == QLatin1Char(':')) {
+            fields.append(current);
+            current.clear();
+        } else {
+            current.append(c);
+        }
+    }
+    fields.append(current);
+    return fields;
+}
+
+// static
+QString WWifiPanel::signalBars(int signal) {
+    // Block elements from DejaVu Sans, which the Pi has; a figure space
+    // (U+2007) pads the missing bars so the SSIDs line up.
+    if (signal > 75) {
+        return QStringLiteral("▂▄▆█");
+    } else if (signal > 50) {
+        return QStringLiteral("▂▄▆ ");
+    } else if (signal > 25) {
+        return QStringLiteral("▂▄  ");
+    }
+    return QStringLiteral("▂   ");
+}
+
+// --------------------------------------------------------------- status ---
+
+void WWifiPanel::refreshStatus() {
+    if (!m_open) {
+        return;
+    }
+    runNmcli(QStringList() << kTerse << QStringLiteral("-f")
+                           << QStringLiteral("DEVICE,TYPE,STATE,CONNECTION")
+                           << QStringLiteral("dev") << QStringLiteral("status"),
+            [this](int exitCode, const QString& out, const QString&) {
+                if (!m_open) {
+                    return;
+                }
+                if (exitCode == -2) {
+                    m_pStatus->setText(QStringLiteral("NETWORKMANAGER (nmcli) NOT FOUND"));
+                    return;
+                }
+                if (exitCode != 0) {
+                    m_pStatus->setText(QStringLiteral("WI-FI STATUS UNAVAILABLE"));
+                    return;
+                }
+                QString device;
+                QString state;
+                QString connection;
+                const QStringList lines = out.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+                for (const QString& line : lines) {
+                    const QStringList f = splitTerse(line);
+                    if (f.size() >= 4 && f.at(1) == QStringLiteral("wifi")) {
+                        device = f.at(0);
+                        state = f.at(2);
+                        connection = f.at(3);
+                        break;
+                    }
+                }
+                m_wifiDevice = device;
+                if (device.isEmpty()) {
+                    m_pStatus->setText(QStringLiteral("NO WI-FI ADAPTER"));
+                    return;
+                }
+                if (state.startsWith(QStringLiteral("connected"))) {
+                    const QString base = QStringLiteral("CONNECTED TO %1").arg(connection);
+                    m_pStatus->setText(base);
+                    runNmcli(QStringList() << QStringLiteral("-g")
+                                           << QStringLiteral("IP4.ADDRESS")
+                                           << QStringLiteral("dev")
+                                           << QStringLiteral("show") << device,
+                            [this, base](int code, const QString& ipOut, const QString&) {
+                                if (!m_open || code != 0) {
+                                    return;
+                                }
+                                const QString ip = ipOut.trimmed()
+                                                           .section(QLatin1Char('|'), 0, 0)
+                                                           .trimmed()
+                                                           .section(QLatin1Char('/'), 0, 0);
+                                if (!ip.isEmpty()) {
+                                    m_pStatus->setText(base +
+                                            QStringLiteral("  ·  ") + ip);
+                                }
+                            });
+                } else if (state.startsWith(QStringLiteral("connecting"))) {
+                    m_pStatus->setText(QStringLiteral("CONNECTING…"));
+                } else if (state.startsWith(QStringLiteral("unavailable"))) {
+                    m_pStatus->setText(QStringLiteral("WI-FI IS OFF"));
+                } else {
+                    m_pStatus->setText(QStringLiteral("NOT CONNECTED"));
+                }
+            });
+}
+
+// ----------------------------------------------------------------- scan ---
+
+void WWifiPanel::startScan() {
+    const int generation = ++m_scanGeneration;
+    setHint(QStringLiteral("SCANNING…"));
+    // Saved profiles first (so a known network connects without asking for
+    // its password again), then the scan itself.
+    runNmcli(QStringList() << kTerse << QStringLiteral("-f")
+                           << QStringLiteral("NAME,TYPE")
+                           << QStringLiteral("con") << QStringLiteral("show"),
+            [this, generation](int, const QString& savedOut, const QString&) {
+                if (generation != m_scanGeneration) {
+                    return; // page closed or rescanned meanwhile
+                }
+                listNetworks(generation, savedOut, true);
+            });
+}
+
+void WWifiPanel::listNetworks(int generation, const QString& savedOut, bool rescan) {
+    QStringList args;
+    args << kTerse << QStringLiteral("-f")
+         << QStringLiteral("IN-USE,SIGNAL,SECURITY,SSID")
+         << QStringLiteral("dev") << QStringLiteral("wifi") << QStringLiteral("list")
+         << QStringLiteral("--rescan")
+         << (rescan ? QStringLiteral("yes") : QStringLiteral("no"));
+    runNmcli(args,
+            [this, generation, savedOut, rescan](
+                    int exitCode, const QString& out, const QString& err) {
+                if (generation != m_scanGeneration) {
+                    return;
+                }
+                if (exitCode == -2) {
+                    m_networks.clear();
+                    renderList();
+                    setHint(QStringLiteral("NETWORKMANAGER (nmcli) NOT FOUND"), true);
+                    return;
+                }
+                if (exitCode != 0 && rescan) {
+                    // NM refuses a fresh scan right after the previous one;
+                    // fall back to whatever it already knows.
+                    listNetworks(generation, savedOut, false);
+                    return;
+                }
+                if (exitCode != 0) {
+                    m_networks.clear();
+                    renderList();
+                    setHint(QStringLiteral("SCAN FAILED: %1").arg(err.left(70)), true);
+                    return;
+                }
+                parseScan(savedOut, out);
+                renderList();
+            });
+}
+
+void WWifiPanel::parseScan(const QString& savedOut, const QString& scanOut) {
+    QSet<QString> saved;
+    const QStringList savedLines = savedOut.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    for (const QString& line : savedLines) {
+        const QStringList f = splitTerse(line);
+        if (f.size() >= 2 && f.at(1) == QStringLiteral("802-11-wireless")) {
+            saved.insert(f.at(0));
+        }
+    }
+
+    QList<Network> networks;
+    const QStringList lines = scanOut.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    for (const QString& line : lines) {
+        const QStringList f = splitTerse(line);
+        if (f.size() < 4) {
+            continue;
+        }
+        Network n;
+        n.inUse = f.at(0).trimmed() == QStringLiteral("*");
+        n.signal = f.at(1).toInt();
+        const QString security = f.at(2).trimmed();
+        n.secured = !security.isEmpty();
+        n.enterprise = security.contains(QStringLiteral("802.1X"));
+        // SSID is the last field on purpose: it may itself contain ':'.
+        n.ssid = f.mid(3).join(QLatin1Char(':'));
+        if (n.ssid.isEmpty()) {
+            continue; // hidden network
+        }
+        n.saved = saved.contains(n.ssid);
+        // One row per SSID: several access points share a name; keep the
+        // strongest and remember if any of them is the one we are on.
+        bool merged = false;
+        for (Network& existing : networks) {
+            if (existing.ssid == n.ssid) {
+                existing.inUse = existing.inUse || n.inUse;
+                existing.signal = qMax(existing.signal, n.signal);
+                merged = true;
+                break;
+            }
+        }
+        if (!merged) {
+            networks.append(n);
+        }
+    }
+    std::stable_sort(networks.begin(), networks.end(),
+            [](const Network& a, const Network& b) {
+                if (a.inUse != b.inUse) {
+                    return a.inUse;
+                }
+                return a.signal > b.signal;
+            });
+    m_networks = networks;
+}
+
+// ----------------------------------------------------------------- list ---
+
+void WWifiPanel::renderList() {
+    const int rows = m_rows.size();
+    if (rows == 0) {
+        return;
+    }
+    const int pages = qMax(1, (m_networks.size() + rows - 1) / rows);
+    m_page = qBound(0, m_page, pages - 1);
+    for (int i = 0; i < rows; ++i) {
+        QPushButton* pRow = m_rows.at(i);
+        const int index = m_page * rows + i;
+        if (index >= m_networks.size()) {
+            pRow->hide();
+            continue;
+        }
+        const Network& n = m_networks.at(index);
+        QString suffix;
+        const char* state = "normal";
+        if (!m_armedForget.isEmpty() && n.ssid == m_armedForget) {
+            pRow->setText(QStringLiteral("TAP AGAIN TO FORGET  %1").arg(n.ssid));
+            state = "armed";
+        } else {
+            if (n.inUse) {
+                suffix = QStringLiteral("  ·  CONNECTED");
+                state = "connected";
+            } else if (n.enterprise) {
+                suffix = QStringLiteral("  ·  ENTERPRISE");
+            } else if (n.saved) {
+                suffix = QStringLiteral("  ·  SAVED");
+            } else if (!n.secured) {
+                suffix = QStringLiteral("  ·  OPEN");
+            }
+            pRow->setText(QStringLiteral("%1   %2%3")
+                                  .arg(signalBars(n.signal), n.ssid, suffix));
+        }
+        setRowState(pRow, state);
+        pRow->show();
+    }
+    if (m_entry) {
+        return; // the list is hidden behind the password entry
+    }
+    if (m_networks.isEmpty()) {
+        setHint(QStringLiteral("NO NETWORKS FOUND — TAP RESCAN"));
+    } else if (pages > 1) {
+        setHint(QStringLiteral("PAGE %1/%2  ·  TAP A NETWORK TO CONNECT  ·  "
+                               "TAP THE CONNECTED ONE TO FORGET IT")
+                        .arg(m_page + 1)
+                        .arg(pages));
+    } else {
+        setHint(QStringLiteral("TAP A NETWORK TO CONNECT  ·  "
+                               "TAP THE CONNECTED ONE TO FORGET IT"));
+    }
+}
+
+void WWifiPanel::rowTapped(int row) {
+    if (m_busy || m_entry) {
+        return;
+    }
+    const int index = m_page * m_rows.size() + row;
+    if (index < 0 || index >= m_networks.size()) {
+        return;
+    }
+    const Network n = m_networks.at(index);
+    if (n.inUse) {
+        // Tap-again-to-confirm, like POWER OFF in the settings menu.
+        if (m_armedForget == n.ssid) {
+            m_forgetDisarmTimer.stop();
+            m_armedForget.clear();
+            forgetNetwork(n.ssid);
+            return;
+        }
+        m_armedForget = n.ssid;
+        m_forgetDisarmTimer.start();
+        renderList();
+        return;
+    }
+    m_forgetDisarmTimer.stop();
+    m_armedForget.clear();
+    if (n.enterprise) {
+        renderList();
+        setHint(QStringLiteral("ENTERPRISE (802.1X) NETWORKS CAN'T BE JOINED FROM HERE"), true);
+        return;
+    }
+    if (n.saved || !n.secured) {
+        startConnect(n, QString());
+        return;
+    }
+    beginEntry(n, QString());
+}
+
+// ---------------------------------------------------------------- entry ---
+
+void WWifiPanel::beginEntry(const Network& network, const QString& hint) {
+    m_entry = true;
+    m_entryNetwork = network;
+    m_entryText.clear();
+    m_pEntryTitle->setText(QStringLiteral("PASSWORD FOR %1").arg(network.ssid));
+    refreshEntryText();
+    setEntryHint(hint, !hint.isEmpty());
+    m_pStatus->hide();
+    m_pListBox->hide();
+    m_pHint->hide();
+    m_pEntryBox->show();
+    emit entryModeChanged(true);
+}
+
+void WWifiPanel::endEntry() {
+    if (!m_entry) {
+        return;
+    }
+    m_entry = false;
+    m_entryText.clear();
+    m_pEntryBox->hide();
+    m_pStatus->show();
+    m_pListBox->show();
+    m_pHint->show();
+    emit entryModeChanged(false);
+    renderList();
+}
+
+void WWifiPanel::confirmEntry() {
+    if (!m_entry || m_busy) {
+        return;
+    }
+    if (m_entryText.size() < kMinPasswordLength) {
+        setEntryHint(QStringLiteral("WI-FI PASSWORDS ARE AT LEAST %1 CHARACTERS")
+                             .arg(kMinPasswordLength),
+                true);
+        return;
+    }
+    startConnect(m_entryNetwork, m_entryText);
+}
+
+void WWifiPanel::appendText(const QString& text) {
+    if (!m_entry || m_entryText.size() >= kMaxPasswordLength) {
+        return;
+    }
+    m_entryText.append(text);
+    refreshEntryText();
+}
+
+void WWifiPanel::backspace() {
+    if (!m_entry || m_entryText.isEmpty()) {
+        return;
+    }
+    m_entryText.chop(1);
+    refreshEntryText();
+}
+
+void WWifiPanel::clearText() {
+    if (!m_entry) {
+        return;
+    }
+    m_entryText.clear();
+    refreshEntryText();
+}
+
+void WWifiPanel::refreshEntryText() {
+    // Shown in the clear on purpose: there is no way to see what a fat-finger
+    // typed on a touchscreen otherwise, and this is the operator's own unit.
+    const bool empty = m_entryText.isEmpty();
+    m_pEntryText->setText(empty
+                    ? QStringLiteral("type the password with the keyboard below")
+                    : m_entryText);
+    m_pEntryText->setProperty("placeholder", empty);
+    restyle(m_pEntryText);
+}
+
+// -------------------------------------------------------------- connect ---
+
+void WWifiPanel::startConnect(const Network& network, const QString& password) {
+    if (m_busy) {
+        return;
+    }
+    m_busy = true;
+    const QString connecting = QStringLiteral("CONNECTING TO %1…").arg(network.ssid);
+    if (m_entry) {
+        setEntryHint(connecting);
+    } else {
+        setHint(connecting);
+    }
+    // "dev wifi connect" reuses an existing profile for the SSID (updating
+    // its password when one is given) and creates one otherwise, so it
+    // serves saved, open and new networks alike.
+    QStringList args;
+    args << QStringLiteral("-w") << QString::number(kConnectTimeoutSeconds)
+         << QStringLiteral("dev") << QStringLiteral("wifi")
+         << QStringLiteral("connect") << network.ssid;
+    if (!password.isEmpty()) {
+        args << QStringLiteral("password") << password;
+    }
+    runNmcli(args,
+            [this, network](int exitCode, const QString&, const QString& err) {
+                m_busy = false;
+                if (exitCode == 0) {
+                    endEntry();
+                    setHint(QStringLiteral("CONNECTED TO %1").arg(network.ssid));
+                    refreshStatus();
+                    startScan();
+                    return;
+                }
+                if (exitCode == -2) {
+                    const QString msg = QStringLiteral("NETWORKMANAGER (nmcli) NOT FOUND");
+                    if (m_entry) {
+                        setEntryHint(msg, true);
+                    } else {
+                        setHint(msg, true);
+                    }
+                    return;
+                }
+                if (m_entry || !network.saved) {
+                    // A failed attempt leaves a half-made profile behind that
+                    // would otherwise show up as SAVED and fail silently next
+                    // time. Drop it; the next CONNECT starts clean.
+                    runNmcli(QStringList() << QStringLiteral("con")
+                                           << QStringLiteral("delete")
+                                           << QStringLiteral("id") << network.ssid,
+                            [](int, const QString&, const QString&) {},
+                            true);
+                }
+                if (m_entry) {
+                    setEntryHint(QStringLiteral("COULDN'T CONNECT — CHECK THE "
+                                                "PASSWORD AND TRY AGAIN"),
+                            true);
+                    return;
+                }
+                if (network.saved && network.secured) {
+                    Network again = network;
+                    again.saved = false;
+                    beginEntry(again,
+                            QStringLiteral("THE SAVED PASSWORD DIDN'T WORK — TYPE IT AGAIN"));
+                    return;
+                }
+                renderList();
+                setHint(QStringLiteral("COULDN'T CONNECT TO %1").arg(network.ssid), true);
+                qWarning() << "Wi-Fi: connect failed:" << err;
+            },
+            true);
+}
+
+void WWifiPanel::forgetNetwork(const QString& ssid) {
+    if (m_busy) {
+        return;
+    }
+    m_busy = true;
+    setHint(QStringLiteral("FORGETTING %1…").arg(ssid));
+    runNmcli(QStringList() << QStringLiteral("con") << QStringLiteral("delete")
+                           << QStringLiteral("id") << ssid,
+            [this, ssid](int exitCode, const QString&, const QString&) {
+                m_busy = false;
+                refreshStatus();
+                startScan();
+                if (exitCode != 0) {
+                    setHint(QStringLiteral("COULDN'T FORGET %1").arg(ssid), true);
+                }
+            },
+            true);
+}
+
+// ------------------------------------------------------------ page state ---
+
+void WWifiPanel::open() {
+    m_open = true;
+    m_page = 0;
+    m_armedForget.clear();
+    m_forgetDisarmTimer.stop();
+    endEntry();
+    m_pStatus->setText(QStringLiteral("CHECKING WI-FI…"));
+    refreshStatus();
+    startScan();
+    m_statusTimer.start();
+}
+
+void WWifiPanel::close() {
+    m_open = false;
+    m_statusTimer.stop();
+    m_forgetDisarmTimer.stop();
+    m_armedForget.clear();
+    ++m_scanGeneration; // drop any scan still in flight
+    endEntry();
+}
+
+void WWifiPanel::back() {
+    if (m_entry) {
+        endEntry();
+        return;
+    }
+    emit closeRequested();
+}
+
+void WWifiPanel::rescan() {
+    if (!m_open || m_entry) {
+        return;
+    }
+    refreshStatus();
+    startScan();
+}
+
+void WWifiPanel::prevPage() {
+    if (m_entry || m_page <= 0) {
+        return;
+    }
+    --m_page;
+    renderList();
+}
+
+void WWifiPanel::nextPage() {
+    if (m_entry) {
+        return;
+    }
+    const int rows = m_rows.size();
+    if (rows == 0 || (m_page + 1) * rows >= m_networks.size()) {
+        return;
+    }
+    ++m_page;
+    renderList();
+}
+
+// -------------------------------------------------------------- helpers ---
+
+void WWifiPanel::setHint(const QString& text, bool error) {
+    m_pHint->setText(text);
+    m_pHint->setProperty("error", error);
+    restyle(m_pHint);
+}
+
+void WWifiPanel::setEntryHint(const QString& text, bool error) {
+    m_pEntryHint->setText(text);
+    m_pEntryHint->setProperty("error", error);
+    restyle(m_pEntryHint);
+}
+
+void WWifiPanel::setRowState(QPushButton* pRow, const char* state) {
+    const QString value = QString::fromLatin1(state);
+    if (pRow->property("rowstate").toString() == value) {
+        return;
+    }
+    pRow->setProperty("rowstate", value);
+    restyle(pRow);
+}
+
+// Dynamic-property selectors ([rowstate="armed"], [error="true"]) are only
+// re-evaluated when the widget is re-polished.
+// static
+void WWifiPanel::restyle(QWidget* pWidget) {
+    pWidget->style()->unpolish(pWidget);
+    pWidget->style()->polish(pWidget);
+    pWidget->update();
+}
