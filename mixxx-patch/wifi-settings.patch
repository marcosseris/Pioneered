+void LibraryControl::setupOnScreenKeyboard(OnScreenKeyboard* pOsk,
+        const QString& prefix,
+        std::function<void(const QString&)> onText,
+        std::function<void()> onBackspace,
+        std::function<void()> onClear) {
+    const auto makeControl = [&prefix](const QString& item) {
+        return std::make_unique<ControlPushButton>(ConfigKey(
+                QStringLiteral("[Library]"),
+                QStringLiteral("%1_%2").arg(prefix, item)));
+    };
+    // Shift and symbols are latches the skin's shift / ?123 keys toggle.
+    // TOGGLE mode is what makes a skin PushButton flip them per tap instead
+    // of holding them only while the finger is down.
+    pOsk->shift = makeControl(QStringLiteral("shift"));
+    pOsk->shift->setStates(2);
+    pOsk->shift->setButtonMode(ControlPushButton::TOGGLE);
+    pOsk->symbols = makeControl(QStringLiteral("symbols"));
+    pOsk->symbols->setStates(2);
+    pOsk->symbols->setButtonMode(ControlPushButton::TOGGLE);
+    ControlPushButton* pShift = pOsk->shift.get();
+
+    // Act on the press edge only (value > 0); the release drops a consumed
+    // shift, so the shifted key face stays under the finger until it lifts.
+    const auto addKey = [&](const QString& item, const QString& text) {
+        auto pKey = makeControl(item);
+        connect(pKey.get(),
+                &ControlPushButton::valueChanged,
+                this,
+                [pOsk, pShift, text, onText](double value) {
+                    if (value > 0.0) {
+                        if (pShift->get() > 0.0) {
+                            onText(text.toUpper());
+                            pOsk->shiftConsumed = true;
+                        } else {
+                            onText(text);
+                        }
+                    } else if (pOsk->shiftConsumed) {
+                        pOsk->shiftConsumed = false;
+                        pShift->setAndConfirm(0.0);
+                    }
+                });
+        pOsk->keys.push_back(std::move(pKey));
+    };
+    // Letters and digits: [Library],<prefix>_key_<char>
+    const QString kAlnum = QStringLiteral("abcdefghijklmnopqrstuvwxyz0123456789");
+    for (const QChar& ch : kAlnum) {
+        addKey(QStringLiteral("key_%1").arg(ch), QString(ch));
+    }
+    // Punctuation: [Library],<prefix>_key_c<codepoint>. The characters
+    // themselves cannot name a control (',' splits group from item in a
+    // ConfigKey), so the skin's symbol keys carry the decimal code point.
+    const QString kSymbols = QStringLiteral("!@#$%^&*()~-_=+[]{};:`'\",.<>/?\\|");
+    for (const QChar& ch : kSymbols) {
+        addKey(QStringLiteral("key_c%1").arg(ch.unicode()), QString(ch));
+    }
+    pOsk->space = makeControl(QStringLiteral("space"));
+    connect(pOsk->space.get(),
+            &ControlPushButton::valueChanged,
+            this,
+            [onText](double value) {
+                if (value > 0.0) {
+                    onText(QStringLiteral(" "));
+                }
+            });
+    pOsk->backspace = makeControl(QStringLiteral("backspace"));
+    connect(pOsk->backspace.get(),
+            &ControlPushButton::valueChanged,
+            this,
+            [onBackspace](double value) {
+                if (value > 0.0) {
+                    onBackspace();
+                }
+            });
+    pOsk->clear = makeControl(QStringLiteral("clear"));
+    connect(pOsk->clear.get(),
+            &ControlPushButton::valueChanged,
+            this,
+            [onClear](double value) {
+                if (value > 0.0) {
+                    onClear();
+                }
+            });
+}
