+QWidget* LegacySkinParser::parseWifiPanel(const QDomElement& node) {
+    // Pioneered: body of the Wi-Fi settings page (network list, status,
+    // password being typed). The buttons and keyboard around it are plain
+    // skin widgets; LibraryControl forwards their controls to this panel
+    // once it is bound.
+    WWifiPanel* pPanel = new WWifiPanel(m_pParent);
+    commonWidgetSetup(node, pPanel, false);
+    pPanel->setup(node, *m_pContext);
+
+    m_pLibrary->bindWifiPanel(pPanel);
+
+    return pPanel;
+}
