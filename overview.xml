<Template>
  <WidgetGroup>
    <ObjectName>Overview</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,0me</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>Waveforms_Container</ObjectName>
        <Layout>horizontal</Layout>
        <Children>
          <!-- RMX mode takes the waveforms' place while it is open; the
               BeatFX column beside it, with the RMX button, stays. -->
          <WidgetGroup>
            <ObjectName>WaveformsOrRmx</ObjectName>
            <Layout>vertical</Layout>
            <Size>0me,0me</Size>
            <Children>
              <WidgetGroup>
                <Layout>vertical</Layout>
                <Size>0me,0me</Size>
                <Children>
                  <Template src="skin:waveforms.xml"></Template>
                </Children>
                <Connection>
                  <ConfigKey persist="false">[Pioneered],rmx_mode</ConfigKey>
                  <Transform><Not/></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <Template src="skin:rmx.xml"></Template>
            </Children>
          </WidgetGroup>
          <Template src="skin:effects.xml"></Template>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>Decks</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,150max</Size>
        <Children>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">1</SetVariable>
          </Template>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">2</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
