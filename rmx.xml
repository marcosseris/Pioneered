<!--
  RMX mode: a few of the RMX-1000's X-PAD tricks, in place of the waveforms
  while the RMX button under the Color FX is lit ([Pioneered],rmx_mode).
  The drums are made by the patched Mixxx (rmx.patch), play on the master
  and in the headphones, and always go through the Beat FX.

    header  what the drums follow: the master deck and its BPM, or FREE when
            no deck is playing, and a light on every beat
    pads    KICK, SNARE, CLAP, HAT: a tap plays one hit, holding rolls at the
            ROLL rate, in time with the beat. Each pad lights on every hit.
            BUILD: a two-bar snare roll that speeds up into the drop; tap
            again to stop it.
    ROLL    1 SHOT (no roll), then 1/1 to 1/16 of a beat
    LEVEL   the drums' volume

  The pad row and the ROLL row share the height equally, and five pads
  against six rates keeps every button about the same size. The screen is
  multi-touch (every Mixxx widget takes its own touch), so pads can be held
  together and a rate changed while a pad rolls.
-->
<Template>
  <WidgetGroup>
    <ObjectName>RmxPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>RmxHeader</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,28f</Size>
        <Children>
          <Label>
            <ObjectName>RmxTitle</ObjectName>
            <Text>RMX</Text>
          </Label>
          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
          <Label>
            <ObjectName>RmxFollow</ObjectName>
            <Text>DECK 1</Text>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_deck</ConfigKey>
              <Transform><IsEqual>1</IsEqual></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </Label>
          <Label>
            <ObjectName>RmxFollow</ObjectName>
            <Text>DECK 2</Text>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_deck</ConfigKey>
              <Transform><IsEqual>2</IsEqual></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </Label>
          <Label>
            <ObjectName>RmxFollow</ObjectName>
            <Text>FREE</Text>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_deck</ConfigKey>
              <Transform><IsEqual>0</IsEqual></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </Label>
          <Number>
            <ObjectName>RmxBpm</ObjectName>
            <NumberOfDigits>1</NumberOfDigits>
            <Text>%1 BPM</Text>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_bpm</ConfigKey>
            </Connection>
          </Number>
          <Label>
            <ObjectName>RmxBeat</ObjectName>
            <Size>22f,0me</Size>
            <Text>&#9679;</Text>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_beat</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </Label>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>RmxPads</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <Template src="skin:templates/rmx_pad.xml">
            <SetVariable name="pad">1</SetVariable>
            <SetVariable name="name">Kick</SetVariable>
            <SetVariable name="label">KICK</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_pad.xml">
            <SetVariable name="pad">2</SetVariable>
            <SetVariable name="name">Snare</SetVariable>
            <SetVariable name="label">SNARE</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_pad.xml">
            <SetVariable name="pad">3</SetVariable>
            <SetVariable name="name">Clap</SetVariable>
            <SetVariable name="label">CLAP</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_pad.xml">
            <SetVariable name="pad">4</SetVariable>
            <SetVariable name="name">Hat</SetVariable>
            <SetVariable name="label">HAT</SetVariable>
          </Template>
          <PushButton>
            <ObjectName>RmxBuild</ObjectName>
            <SizePolicy>me,me</SizePolicy>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>BUILD</Text></State>
            <State><Number>1</Number><Text>BUILD</Text></State>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_build</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <!-- ROLL: radio buttons, one always lit, like the Color FX -->
      <Label>
        <ObjectName>RmxCaption</ObjectName>
        <Size>0me,16f</Size>
        <Text>ROLL</Text>
      </Label>
      <WidgetGroup>
        <ObjectName>RmxRates</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <Template src="skin:templates/rmx_rate_button.xml">
            <SetVariable name="rate">0</SetVariable>
            <SetVariable name="label">1 SHOT</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_rate_button.xml">
            <SetVariable name="rate">1</SetVariable>
            <SetVariable name="label">1/1</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_rate_button.xml">
            <SetVariable name="rate">2</SetVariable>
            <SetVariable name="label">1/2</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_rate_button.xml">
            <SetVariable name="rate">3</SetVariable>
            <SetVariable name="label">1/4</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_rate_button.xml">
            <SetVariable name="rate">4</SetVariable>
            <SetVariable name="label">1/8</SetVariable>
          </Template>
          <Template src="skin:templates/rmx_rate_button.xml">
            <SetVariable name="rate">5</SetVariable>
            <SetVariable name="label">1/16</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <!-- LEVEL - / value / + -->
      <WidgetGroup>
        <ObjectName>RmxRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,40f</Size>
        <Children>
          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
          <Label>
            <ObjectName>RmxRowLabel</ObjectName>
            <Size>58f,0me</Size>
            <Text>LEVEL</Text>
          </Label>
          <PushButton>
            <ObjectName>RmxStep</ObjectName>
            <Size>48f,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>&#8722;</Text></State>
            <State><Number>1</Number><Text>&#8722;</Text></State>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_level_down</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <Number>
            <ObjectName>RmxLevel</ObjectName>
            <Size>64f,0me</Size>
            <NumberOfDigits>0</NumberOfDigits>
            <Text>%1 %</Text>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_level</ConfigKey>
            </Connection>
          </Number>
          <PushButton>
            <ObjectName>RmxStep</ObjectName>
            <Size>48f,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>+</Text></State>
            <State><Number>1</Number><Text>+</Text></State>
            <Connection>
              <ConfigKey persist="false">[Pioneered],rmx_level_up</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

    </Children>
    <Connection>
      <ConfigKey persist="false">[Pioneered],rmx_mode</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
