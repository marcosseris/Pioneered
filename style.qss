/* Pioneer Colours:

Play button: #6ee128
Cue button: #eb870f
Slip button: #d73535
Tabs on top: #c3d541
Headers: #32323c
Title bg: #112f5c
Blue: #2d85cd
White: #e5e6ea

*/

/* Fork additions (canon since the touch-browse work, see
   docs/superpowers/specs/2026-07-12-track-search-osk-design.md):

Accent / armed / active: #b6294c   (pressed faces: #c62d54 -> #a62446)
Deck 1 fill / edge:      #112f5c / #2d85cd
Deck 2 fill / edge:      #5c1120 / #d73535

Surface ladder (dark -> light):
  black -> #0d0d10 (input) -> #16161a (panes) -> #1a1a20 (rows)
        -> #32323c (headers) -> #3a3a44 (keys)
Border ladder (dim -> bright):
  #3c3c46 (resting) -> #4a4a52 (inactive chrome) -> #5a5a66 (hover)
        -> #6a6a76 (pressed)
Dim text: #8f8f99

Radius scale: 3px small controls, 4px touch targets, 8px panels/banners.
Deliberate exceptions: the CDJ notch on #WaveformInfo_Header (10px 25px)
and the scrollbar handle pill (6px).

QSS has no variables, so every value above is repeated literally. Buttons
with a fill carry a top-down qlineargradient (~8% lift at the top edge) so
they read as moulded hardware rather than flat rectangles; buttons that are
deliberately chrome-less (the WPushButton base, #EffectToggle, #SettingsCog)
stay transparent. The white flash faces (USB state 2, LOAD hold-to-restart)
stay flat white on purpose -- they have to be maximally bright.

*/

/* DEBUG
* {
  border: 1px solid rgba(255,255,255,0.1);
}
/* END */

#Mixxx {
  background-color: black;
}

* {
  font-family: 'Open Sans', sans-serif;
}

QMenuBar, QMenuBar::item, QMenu, QMenu::item {
  background-color: black;
  color: gray;
}

QMenuBar::item:pressed, QMenu::item:selected, QMenu::item:pressed {
    background-color: rgba(255,255,255,0.2);
}

/************************************************************************/
/*     Buttons                                                          */
/************************************************************************/

WPushButton {
  color: #e5e6ea;
  background-color: transparent;
  border: 1px solid #3c3c46;
  border-radius: 3px;
  outline: none;
}

WPushButton:hover {
  border: 1px solid #5a5a66;
}

WPushButton[value="1"] {
  color: #e5e6ea;
  border: 1px solid #5a5a66;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #3a3a45, stop:1 #2e2e37);
}

WPushButton[value="1"]:hover {
  border: 1px solid #4e4e59;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #38383f, stop:1 #2c2c34);
}

/* Touch-down feedback. This is a touchscreen appliance: without a :pressed
   face a tap is unacknowledged until the action it triggered lands, which
   reads as lag even when nothing is actually slow. Placed after the
   [value="1"] rules above -- :pressed and [value="1"] have equal
   specificity, so source order is what decides the winner. */
WPushButton:pressed {
  border: 1px solid #6a6a76;
  background-color: #2a2a32;
}

/************************************************************************/
/*     Deck                                                             */
/************************************************************************/

#Deck {
  border: 1px solid transparent;
  border-radius: 3px;
}

#Deck[highlight="1"] {
  border: 1px solid #e5e6ea;
}

#DeckBPMWrapper {
  border: 2px solid #e5e6ea;
  border-radius: 4px;
  margin-bottom: 4px;
  padding-right: 2px;
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#DeckBPM {
  font-size: 20px;
}

#DeckBPMTitleWrapper {
  padding: 0 2px;
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#DeckBPMTitle {
  font-size: 8px;
  font-weight: bold;
}

#TrackBPMRangeContainer {
  padding: 5px;
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
}

#DeckBPMRangePercent {
  background-color: #222222;
  padding: 0px;
}

#BPMRangePlusMinus, #RateDisplay {
    font-size: 12px;
    font-weight: bold;
}

#DeckHeader {
  background-color: #112f5c;
  padding: 2px;
}

#DeckOverview {
  margin: 50% 0;
}

#DeckTitle, #DeckTitleNote {
  font-size: 20px;
}

#DeckTitleNote {
  margin: 0 2px;
}

#DeckChannelTitle, #DeckTrackTimeTitle, #DeckTempoTitle {
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#DeckPlayingLeft, #DeckPlayingRight {
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#DeckTrackTimeWrapper {
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
}

#DeckTrackTime {
  font-size: 36px;
}

#DeckTrackTime[highlight="1"] {
  color: transparent;
}

#DeckTrackTimeMini {
  font-size: 20px;
}

#DeckTrackTimeMini[highlight="1"] {
  color: transparent;
}

#DeckTrackNumberContainer {
  margin: 0 4px;
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
}

#TrackNumberWrapper, #DeckChannelTitleWrapper {
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
}

#TrackNumberTitle {
  font-size: 12px;
  text-transform: uppercase;
}

#TrackNumber {
  font-size: 20px;
  font-weight: bold;
}

/************************************************************************/
/*     BeatFX                                                           */
/************************************************************************/

#BeatFX_Container {
  border: 2px solid #32323c;
  margin-left: 4px;
  qproperty-layoutAlignment: 'AlignCenter | AlignTop';
}

#BeatFX_Header {
  background-color: #32323c;
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
}

#BeatFX_Title {
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFX_Unit[highlight="0"] {
  padding: 1px;
  border: 1px solid #32323c;
}

#BeatFX_Unit[highlight="1"] {
  padding: 1px;
  border: 1px solid #2d85cd;
}

/************************************************************************/
/*     Effects                                                          */
/************************************************************************/

WEffectSelector {
  background-color: transparent;
  color: #2d85cd;
  font-size: 14px;
  font-weight: bold;
  padding: 4px;
  text-transform: uppercase;
}

#EffectMeter {
  padding: 0px 1px 0px 1px;
}

#EffectToggle {
  color: #8f8f99;
  font-weight: bold;
  text-transform: uppercase;
}

#EffectToggle[value="1"] {
  color: #2d85cd;
}

/************************************************************************/
/*     Library                                                          */
/************************************************************************/

#LibraryWrapper QScrollBar {
  background-color: gray;
}

#LibraryWrapper QScrollBar::handle:horizontal {
  border: 0;
}

#LibraryWrapper QScrollBar:horizontal {
  height: 0;
  width: 0;
}

#LibraryWrapper QScrollBar:vertical {
  border: 0;
  width: 24px;
}

#LibraryWrapper QScrollBar::handle:vertical {
  background-color: #5f5f6a;
  border-radius: 6px;
  min-height: 48px;
}

#LibraryWrapper QScrollBar::add-page,
#LibraryWrapper QScrollBar::sub-page {
  background-color: black;
}

#LibraryWrapper QScrollBar::add-line,
#LibraryWrapper QScrollBar::sub-line {
  height: 0;
  width: 0;
}

#LibraryWrapper WTrackTableViewHeader::section {
  background-color: #32323c;
  color: #e5e6ea;
  font-weight: bold;
  margin: 2px;
  text-transform: uppercase;
}

#LibraryWrapper QTableView,
#LibraryWrapper WLibraryTextBrowser {
  background-color: black;
  alternate-background-color: #32323c;
  selection-background-color: #e5e6ea;
  color: white;
  selection-color: black;
}

#LibraryWrapper WLibrarySidebar {
  background-color: #16161a;
  selection-background-color: #112f5c;
  color: #d5d6da;
  font-size: 18px;
  font-weight: bold;
  selection-color: white;
}

#LibraryWrapper WLibrarySidebar::item {
  padding: 12px 6px;
}

#LibraryWrapper QPushButton,
#LibraryWrapper QSpinBox,
#LibraryWrapper QComboBox,
#LibraryWrapper QComboBox QAbstractScrollArea {
  background-color: #32323c;
  color: #e5e6ea;
}

WLabel {
  color: #e5e6ea;
}

/* Checkbox in library "Played" column */
#LibraryWrapper WTrackTableView::indicator:unchecked {
  image: url(skin:icons/library_checkbox.svg);
}
#LibraryWrapper WTrackTableView::indicator:hover {
  background-color: #2d85cd;
}
#LibraryWrapper WTrackTableView::indicator:checked {
  image: url(skin:icons/library_checkbox_checked.svg);
}

/* Touch browse pane */
#PlaylistPane {
  background-color: #16161a;
  border-right: 2px solid #32323c;
}

#UsbButtonA, #UsbButtonB {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #20202a, stop:1 #16161c);
  border: 1px solid #3c3c46;
  border-radius: 3px;
  color: #aaaaaa;
  font-size: 18px;
  font-weight: bold;
  margin: 4px;
}

#UsbButtonA[value="1"], #UsbButtonB[value="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid #b6294c;
  color: white;
}

/* State 2 is the eject-hold flash: flat white, maximum brightness. */
#UsbButtonA[value="2"], #UsbButtonB[value="2"] {
  background-color: white;
  border: 1px solid white;
  color: #b6294c;
}

/* Scoped to [value="0"] deliberately, NOT a bare :pressed. A bare
   #UsbButtonA:pressed stays active for the whole eject hold and would
   outrank both [value] rules above (equal specificity, later in the file),
   masking the accelerating 1/2 flash that tells you how long you have held.
   The control stays 0 until the first flash tick at 600ms, so [value="0"]
   covers exactly the window before the flash owns the button: instant
   acknowledgement on the tap that browses, then hands over. */
#UsbButtonA[value="0"]:pressed, #UsbButtonB[value="0"]:pressed {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid #b6294c;
  color: white;
}

/* Centered popup banners (stacked overlay in skin.xml) */
#UsbLockedBanner, #UsbEjectFailedBanner, #LoadBlockedBanner, #TrackMissingBanner,
#RestartingBanner, #PoweringOffBanner, #PowerOffFailedBanner {
  background-color: #b6294c;
  border: 2px solid white;
  border-radius: 8px;
  color: white;
  font-size: 18px;
  font-weight: bold;
  padding: 8px;
  qproperty-alignment: AlignCenter;
}

#UsbLockedBanner {
  font-size: 15px;
  qproperty-wordWrap: true;
}

/* Browse/Search deck strip. The side padding replaces the inset the on-screen
   LOAD buttons used to give this row; without it the overviews would run into
   the edges of the screen. Padding, not margin: Qt turns a styled widget's
   padding into contents margins the child layout respects, while margin on a
   container in a layout does nothing - the same reason every other container
   in this file (#DeckHeader, #TrackBPMRangeContainer) uses padding. */
#DecksRow {
  padding: 0 6px;
}

/************************************************************************/
/*     Waveforms                                                        */
/************************************************************************/

#WaveformInfo {
  margin-right: 10px;
}

#WaveformInfo_Header {
  background-color: #32323c;
  border-top-right-radius: 10px 25px;
  padding-right: 2px;
}

#WaveformInfo_Header[highlight="1"] {
  border: 2px solid #e5e6ea;
}

#WaveformInfo_Title,
#WaveformInfo_Key,
#WaveformInfo_Bars {
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
}

#WaveformInfo_Data_Container,
#WaveformInfo_Key_Container,
#WaveformInfo_Bars_Container,
#WaveformInfo_Loopsize_Container {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
}

#WaveformInfo_Key_Icon {
  background-color: #e5e6ea;
  border-radius: 3px;
  font-size: 14px;
  margin: 4px;
  padding: -6px -6px -3px -2px;
}

#WaveformInfo_Loop_Icon {
  color: white;
  font-size: 20px;
  font-weight: bold;
  margin: 2px;
}

#WaveformInfo_BeatloopSizeSpinBox {
  margin: 3px;
  padding: -4px -4px 0px -8px;
}

WBeatSpinBox {
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
  background-color: #000000;
}

WBeatSpinBox::down-arrow,
WBeatSpinBox::up-arrow,
WBeatSpinBox::down-button,
WBeatSpinBox::up-button {
  width: 0px;
  height: 0px;
  color: #000000;
  background-color: #000000;
}

#WaveformInfo_KeylockButton {
  image: url(skin:icons/keylock.svg) no-repeat center center;
}

#WaveformInfo_QuantizeButton {
  image: url(skin:icons/quantize.svg) no-repeat center center;
}

/************************************************************************/
/*     Tabs                                                             */
/************************************************************************/

/* margin was "10px 10%": Qt Style Sheets have no percentage length (the
   parser takes px/pt/em/ex only), so "10%" silently evaluated to 0 and the
   tabs had no horizontal gutter at all — the gaps came from Qt spreading
   leftover space, which is why they never looked even. Real px values, so
   the gutter between every pair of tabs is identical.

   max-width is gone with it. Capping the tabs left surplus that nothing
   could absorb, and Qt parks that slack at one end of the strip rather than
   splitting it — the tabs stayed equal to each other but the group sat
   off-centre. Uncapped, the three of them divide the space between the
   fixed left counterweight and the cog exactly three ways at any window
   size. On the 800px Pi panel that is ~224px per tab. */
#TabControls WPushButton {
  background-color: black;
  font-weight: bold;
  margin: 8px 6px;
  text-transform: uppercase;
}

/* Dimmed inactive chrome (was gray = #808080) so the active #c3d541 tab
   carries the strip. Border *width* stays 2px and the margins are untouched:
   the tab strip's proportions are the most recognisable thing in the skin. */
#TabControls WPushButton[value="0"] {
  border: 2px solid #4a4a52;
  color: #8f8f99;
}

#TabControls WPushButton[value="1"] {
  border: 2px solid #c3d541;
  color: #c3d541;
}

/* Previews the selection on touch-down: tapping a tab shows the accent
   immediately rather than after the WidgetStack has swapped pages. Scoped to
   [value="0"] so it cannot repaint the already-active tab. */
#TabControls WPushButton[value="0"]:pressed {
  border: 2px solid #c3d541;
  color: #c3d541;
}

/* The cog sits in the corner past an expanding spacer, so it must opt out
   of the tab margins/max-width above or it would be pushed off the edge.
   No border box: it reads as a corner control, not a fourth tab. Selectors
   are two-ID so they outrank #TabControls WPushButton[value="..."] above,
   which would otherwise repaint the cog as a tab. */
#TabSpacer {
  background-color: black;
}

#TabControls #SettingsCog {
  background-color: black;
  border: none;
  color: #8f8f99;
  font-size: 26px;
  margin: 6px 8px 6px 0;
  max-width: 56px;
  padding: 0;
}

#TabControls #SettingsCog[value="1"] {
  color: #c3d541;
}

/* Two IDs, matching the rules above, so it outranks the tab press face. */
#TabControls #SettingsCog:pressed {
  color: #c3d541;
}

/************************************************************************/
/*     Settings panel                                                   */
/************************************************************************/

/* Full-screen modal layer behind the panel: dark, but not opaque, so it
   stays obvious that a set is still running underneath. */
#SettingsOverlay {
  background-color: rgba(0, 0, 0, 200);
}

/* The backdrop around the panel is four transparent buttons that dismiss the
   menu (templates/settings_scrim.xml). They must stay invisible, so every
   face the WPushButton base would give them is cleared here -- including
   [value="1"], which they wear the whole time the panel is open (their value
   IS show_settings), and which would otherwise paint the gradient fill and
   border of a pressed-looking button across the entire screen.

   Selected by their own ID rather than as "#SettingsScrim WPushButton": the
   panel's buttons are descendants of the same scrim group, and a descendant
   selector would tie with #SettingsPanel WPushButton on specificity and be
   decided by source order. */
#SettingsScrimArea,
#SettingsScrimArea[value="1"],
#SettingsScrimArea:hover,
#SettingsScrimArea[value="1"]:hover,
#SettingsScrimArea:pressed {
  background-color: transparent;
  border: none;
}

#SettingsPanel {
  background-color: #32323c;
  border: 2px solid #c3d541;
  border-radius: 8px;
  padding: 8px;
}

#SettingsTitle {
  color: #c3d541;
  font-size: 18px;
  font-weight: bold;
  qproperty-alignment: AlignCenter;
  text-transform: uppercase;
}

/* Two-ID selectors throughout, so the per-button rules outrank this
   descendant one rather than losing to it on specificity. */
#SettingsPanel WPushButton {
  border-radius: 4px;
  font-size: 18px;
  font-weight: bold;
  margin: 6px 10px;
}

#SettingsPanel #SettingsWifi,
#SettingsPanel #SettingsUpdate,
#SettingsPanel #SettingsPowerOff,
#SettingsPanel #SettingsRestart,
#SettingsPanel #SettingsBack {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #16161a, stop:1 black);
  border: 2px solid #4a4a52;
  color: white;
}

/* Armed faces: red fill, so a live one-tap commit never looks like the
   safe state it replaced. */
#SettingsPanel #SettingsPowerOffArmed,
#SettingsPanel #SettingsRestartArmed {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 2px solid white;
  color: white;
}

/* Two-ID selectors, mandatory here: a single "#SettingsPanel WPushButton
   :pressed" rule is one ID plus a pseudo-class and would lose to the two-ID
   per-button rules above, silently doing nothing. The armed faces get no
   press state -- the second tap commits, and it should look committed, not
   like another arming step. */
#SettingsPanel #SettingsWifi:pressed,
#SettingsPanel #SettingsUpdate:pressed,
#SettingsPanel #SettingsPowerOff:pressed,
#SettingsPanel #SettingsRestart:pressed,
#SettingsPanel #SettingsBack:pressed {
  background-color: #1f1f26;
  border: 2px solid #6a6a76;
  color: white;
}

/************************************************************************/
/*     Samplers                                                         */
/************************************************************************/

#Sampler {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #3a3a45, stop:1 #2e2e37);
  border: 2px solid #d73535;
  border-radius: 4px;
  color: white;
  font-size: 24px;
  margin: 4px;
  padding: 2px;
}

#Sampler[value="1"] {
  background-color: #d73535;
}

#Sampler[value="0"]:pressed {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #e04a4a, stop:1 #b32626);
}

#Sampler_Info {
  color: white;
  font-size: 10px;
  margin: 4px;
}

#SamplersDeck1, #SamplersDeck2 {
  margin: 0 4px;
}

/************************************************************************/
/*     Track search + on-screen keyboard                                */
/************************************************************************/

#SearchPage {
  background-color: #16161a;
}

#SearchFieldRow {
  background-color: #1a1a20;
}

#SearchFieldRow WSearchLineEdit {
  background-color: #0d0d10;
  border: 1px solid #45454f;
  border-radius: 3px;
  color: #e6e6e6;
  font-size: 16px;
  margin: 4px;
  padding: 4px 8px;
}

#KbShow {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #20202a, stop:1 #16161c);
  border: 1px solid #3c3c46;
  border-radius: 3px;
  color: #aaaaaa;
  font-size: 18px;
  font-weight: bold;
  margin: 4px;
}

#KbShow[value="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid #b6294c;
  color: white;
}

#Keyboard {
  background-color: #1a1a20;
}

#Keyboard WPushButton {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #43434e, stop:1 #33333c);
  border: 1px solid #4d4d59;
  border-radius: 4px;
  color: #f0f0f0;
  font-size: 15px;
  font-weight: bold;
  margin: 2px;
}

#Keyboard WPushButton:pressed {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid #b6294c;
  color: white;
}

#KbClear, #KbBackspace {
  color: #ffb3c0;
}

#KbDone[value="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid #b6294c;
  color: white;
}

/* SHIFT and ?123 are latches: lit while on. SHIFT is one-shot (drops after
   the next key), ?123 stays until tapped again, hence ABC on its lit face. */
#KbShift, #KbSymbols {
  color: #aaaaaa;
}

#KbShift[value="1"], #KbSymbols[value="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid #b6294c;
  color: white;
}

/************************************************************************/
/*     Wi-Fi page (settings menu > WI-FI)                               */
/************************************************************************/

/* Full-screen sibling of the settings menu inside SettingsOverlay; opaque
   because unlike the menu there is nothing worth glimpsing beneath a
   network list. */
#WifiPage {
  background-color: #16161a;
}

#WifiHeader {
  background-color: #1a1a20;
}

#WifiTitle {
  color: #c3d541;
  font-size: 18px;
  font-weight: bold;
  qproperty-alignment: AlignCenter;
}

#WifiBack, #WifiRescan, #WifiPrev, #WifiNext {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #16161a, stop:1 black);
  border: 2px solid #4a4a52;
  border-radius: 4px;
  color: white;
  font-size: 16px;
  font-weight: bold;
  margin: 6px 8px;
}

#WifiBack:pressed, #WifiRescan:pressed, #WifiPrev:pressed, #WifiNext:pressed {
  background-color: #1f1f26;
  border: 2px solid #6a6a76;
  color: white;
}

/* The C++ panel (WWifiPanel). Its children are plain Qt widgets, so they
   are selected by type + id; WPushButton rules do not reach them. */
#WifiPanel {
  background-color: transparent;
  margin: 2px 12px;
}

#WifiStatus {
  color: #c3d541;
  font-size: 16px;
  font-weight: bold;
  padding: 4px;
}

QPushButton#WifiRow {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #20202a, stop:1 #16161c);
  border: 1px solid #3c3c46;
  border-radius: 4px;
  color: #e6e6e6;
  font-size: 17px;
  font-weight: bold;
  padding: 0 14px;
  text-align: left;
}

QPushButton#WifiRow:pressed {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid #b6294c;
  color: white;
}

/* The network we are on: green, like a Camelot-compatible key. */
QPushButton#WifiRow[rowstate="connected"] {
  border: 1px solid #c3d541;
  color: #c3d541;
}

/* Tap-again-to-forget: the same red the menu's armed POWER OFF wears. */
QPushButton#WifiRow[rowstate="armed"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 1px solid white;
  color: white;
}

#WifiHint, #WifiEntryHint {
  color: #8f8f99;
  font-size: 13px;
  padding: 2px 8px;
}

#WifiHint[error="true"], #WifiEntryHint[error="true"] {
  color: #ff8fa3;
}

#WifiEntryTitle {
  color: #c3d541;
  font-size: 16px;
  font-weight: bold;
  padding-top: 8px;
}

/* The password as typed, in the clear: on a touchscreen with no other
   feedback, seeing it is the only way to catch a wrong key. */
#WifiEntryText {
  background-color: #0d0d10;
  border: 1px solid #45454f;
  border-radius: 3px;
  color: #e6e6e6;
  font-size: 22px;
  font-weight: bold;
  margin: 4px 60px;
  padding: 8px 12px;
}

#WifiEntryText[placeholder="true"] {
  color: #5a5a66;
  font-size: 15px;
  font-weight: normal;
}

/************************************************************************/
/*     Software update page (settings menu > SOFTWARE UPDATE)           */
/************************************************************************/

#UpdatePage {
  background-color: #16161a;
}

#UpdateHeader {
  background-color: #1a1a20;
}

#UpdateTitle {
  color: #c3d541;
  font-size: 18px;
  font-weight: bold;
  qproperty-alignment: AlignCenter;
}

#UpdateBack, #UpdateRun, #UpdateReboot {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #16161a, stop:1 black);
  border: 2px solid #4a4a52;
  border-radius: 4px;
  color: white;
  font-size: 16px;
  font-weight: bold;
  margin: 6px 8px;
}

#UpdateBack:pressed, #UpdateRun:pressed, #UpdateReboot:pressed {
  background-color: #1f1f26;
  border: 2px solid #6a6a76;
  color: white;
}

/* Armed face, and the restart that finishes the job: the same red the
   menu's armed POWER OFF wears. */
#UpdateRunArmed {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 #c62d54, stop:1 #a62446);
  border: 2px solid white;
  border-radius: 4px;
  color: white;
  font-size: 16px;
  font-weight: bold;
  margin: 6px 8px;
}

#UpdateReboot {
  border: 2px solid #c3d541;
  color: #c3d541;
}

/* The C++ panel (WUpdatePanel): plain Qt widgets, so type + id selectors. */
#UpdatePanel {
  background-color: transparent;
  margin: 2px 12px;
}

#UpdateStatus {
  color: #8f8f99;
  font-size: 15px;
  font-weight: bold;
  padding: 4px;
}

#UpdateStatus[state="running"] {
  color: #c3d541;
}

#UpdateStatus[state="ok"] {
  color: #c3d541;
}

#UpdateStatus[state="failed"] {
  color: #ff8fa3;
}

/* The transcript. Monospace so apt's columns line up the way they would in
   a terminal; it is scrolled by dragging, not by the (hidden) scrollbar. */
QPlainTextEdit#UpdateLog {
  background-color: #0d0d10;
  border: 1px solid #45454f;
  border-radius: 3px;
  color: #d0d0d6;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 12px;
  padding: 6px;
}

QPlainTextEdit#UpdateLog QScrollBar:vertical {
  background: transparent;
  width: 6px;
}

QPlainTextEdit#UpdateLog QScrollBar::handle:vertical {
  background: #45454f;
  border-radius: 3px;
}

QPlainTextEdit#UpdateLog QScrollBar::add-line:vertical,
QPlainTextEdit#UpdateLog QScrollBar::sub-line:vertical {
  height: 0;
}
