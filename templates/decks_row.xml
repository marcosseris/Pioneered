<Template>
  <!-- The deck strip at the bottom of Browse and Search: each deck's track
       overview, nothing else. There are no on-screen LOAD buttons - LOAD 1
       and LOAD 2 are physical buttons on the DDJ-400, and duplicating them
       here cost 220px of a 480px-wide screen for a second way to press a
       button the operator's hand is already on. The overviews take that
       width instead, which is where it does some good: at this size the
       overview is the only place a cue point or the played/unplayed split
       is visible while browsing. -->
  <WidgetGroup>
    <ObjectName>DecksRow</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,90f</Size>
    <Children>
      <Template src="skin:deck.xml">
        <SetVariable name="channel">1</SetVariable>
      </Template>
      <!-- USB / load banners moved to the centered popup overlay in skin.xml
           so both deck overviews get equal width with no dead gap between them. -->
      <WidgetGroup>
        <ObjectName>DecksRowSpacer</ObjectName>
        <Size>12f,0me</Size>
      </WidgetGroup>
      <Template src="skin:deck.xml">
        <SetVariable name="channel">2</SetVariable>
      </Template>
    </Children>
  </WidgetGroup>
</Template>
