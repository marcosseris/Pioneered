<Template>
  <!--
    Description:
      One on-screen keyboard key. Two faces share the slot: the unshifted
      one while [Library],<kb_prefix>_shift is 0, the shifted one while it
      is 1 - only ever one of them visible, so the row never changes width.
      Both faces press the same control; LibraryControl::setupOnScreenKeyboard
      decides the case from the shift latch, so the faces are purely what
      you see.
    Variables:
      kb_prefix: control prefix - "search" (track search) or "wifi"
                 (Wi-Fi password entry). See keyboard.xml.
      key_char:  control suffix: the character for letters and digits
                 ("a", "7"), "c<codepoint>" for punctuation ("c33" is "!").
      key_label: face while shift is off.
      key_shift: face while shift is on.
  -->
  <PushButton>
    <ObjectName>KbKey</ObjectName>
    <SizePolicy>me,me</SizePolicy>
    <NumberStates>1</NumberStates>
    <State>
      <Number>0</Number>
      <Text><Variable name="key_label"/></Text>
    </State>
    <Connection>
      <ConfigKey persist="false">[Library],<Variable name="kb_prefix"/>_key_<Variable name="key_char"/></ConfigKey>
      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
    <Connection>
      <ConfigKey persist="false">[Library],<Variable name="kb_prefix"/>_shift</ConfigKey>
      <BindProperty>visible</BindProperty>
      <Transform><Not/></Transform>
    </Connection>
  </PushButton>
  <PushButton>
    <ObjectName>KbKey</ObjectName>
    <SizePolicy>me,me</SizePolicy>
    <NumberStates>1</NumberStates>
    <State>
      <Number>0</Number>
      <Text><Variable name="key_shift"/></Text>
    </State>
    <Connection>
      <ConfigKey persist="false">[Library],<Variable name="kb_prefix"/>_key_<Variable name="key_char"/></ConfigKey>
      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
    <Connection>
      <ConfigKey persist="false">[Library],<Variable name="kb_prefix"/>_shift</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </PushButton>
</Template>
