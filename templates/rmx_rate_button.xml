<!DOCTYPE template>
<!--
  One RMX roll rate.
  Variables:
    rate:  0 (1 SHOT) to 5 (1/16 beat)
    label: the button text
  [Pioneered],rmx_rate_<rate> reads 1 while the rate is selected; a tap
  selects it, and the 0 a tap on the lit one asks for is refused, so the six
  buttons behave as radio buttons (as the Color FX buttons do).
-->
<Template>
  <PushButton>
    <ObjectName>RmxRate</ObjectName>
    <Size>0me,0me</Size>
    <NumberStates>2</NumberStates>
    <State>
      <Number>0</Number>
      <Text><Variable name="label"/></Text>
    </State>
    <State>
      <Number>1</Number>
      <Text><Variable name="label"/></Text>
    </State>
    <Connection>
      <ConfigKey persist="false">[Pioneered],rmx_rate_<Variable name="rate"/></ConfigKey>
    </Connection>
  </PushButton>
</Template>
